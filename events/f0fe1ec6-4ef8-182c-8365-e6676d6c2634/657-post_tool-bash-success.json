      "timeout": 120,
      "command": [
        "cd /home/dilos/A3/agentic/mini-project-template/web && cat >> style.css <<'EOF'",
        "",
        "/* ==========================================================================",
        "   Glisser-déposer + sélecteur de promotion superposé (façon lichess).",
        "   ========================================================================== */",
        "",
        ".drag-ghost {",
        "  position: absolute;",
        "  z-index: 30;",
        "  width: calc(100% / 8);",
        "  height: calc(100% / 8);",
        "  transform: translate(-50%, -50%);",
        "  pointer-events: none;",
        "}",
        "",
        ".drag-ghost img {",
        "  width: 100%;",
        "  height: 100%;",
        "  filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.45));",
        "}",
        "",
        ".promo-overlay {",
        "  position: absolute;",
        "  z-index: 40;",
        "  display: flex;",
        "  flex-direction: column;",
        "  background: var(--elevated);",
        "  border: 1px solid var(--border);",
        "  border-radius: var(--r8);",
        "  overflow: hidden;",
        "  box-shadow: var(--shadow-3);",
        "}",
        "",
        ".promo-overlay button {",
        "  width: calc(min(100vw - 32px, 640px) / 8);",
        "  height: calc(min(100vw - 32px, 640px) / 8);",
        "  min-width: 44px;",
        "  min-height: 44px;",
        "  padding: 4%;",
        "  background: var(--surface);",
        "  border: none;",
        "  border-bottom: 1px solid var(--border);",
        "  cursor: pointer;",
        "  transition: background var(--tr);",
        "}",
        "",
        ".promo-overlay button:last-child { border-bottom: none; }",
        ".promo-overlay button:hover { background: var(--accent); }",
        ".promo-overlay img { width: 100%; height: 100%; pointer-events: none; }",
        "EOF",
        "echo ok"
      ]
    },
