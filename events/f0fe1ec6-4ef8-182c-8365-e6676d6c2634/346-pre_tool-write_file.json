      "content": [
        "\"\"\"Tests for SAN rendering and parsing (chess/engine/san.py).\"\"\"",
        "",
        "import pytest",
        "",
        "from chess.engine.board import parse_square",
        "from chess.engine.fen import START_FEN, board_from_fen",
        "from chess.engine.game import Game",
        "from chess.engine.move import Move",
        "from chess.engine.movegen import legal_moves",
        "from chess.engine.san import move_to_san, san_to_move",
        "",
        "KIWIPETE = \"r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1\"",
        "POS4 = \"r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1\"",
        "OPEN_CASTLING = \"r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1\"",
        "",
        "",
        "def san_of(board, uci: str) -> str:",
        "    return move_to_san(board, Move.from_uci(uci))",
        "",
        "",
        "def test_simple_moves() -> None:",
        "    board = board_from_fen(START_FEN)",
        "    assert san_of(board, \"e2e4\") == \"e4\"",
        "    assert san_of(board, \"g1f3\") == \"Nf3\"",
        "    assert san_of(board, \"b1c3\") == \"Nc3\"",
        "",
        "",
        "def test_capture() -> None:",
        "    # 1.e4 d5 -> exd5",
        "    board = board_from_fen(",
        "        \"rnbqkbnr/ppp1pppp/8/3p4/4P3/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 2\"",
        "    )",
        "    assert san_of(board, \"e4d5\") == \"exd5\"",
        "",
        "",
        "def test_en_passant_capture_san() -> None:",
        "    board = board_from_fen(",
        "        \"rnbqkbnr/ppp1pppp/8/3pP3/8/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 3\"",
        "    )",
        "    assert san_of(board, \"e5d6\") == \"exd6\"",
        "",
        "",
        "def test_disambiguation_by_file() -> None:",
        "    # Knights on b1 and f3 can both reach d2.",
        "    board = board_from_fen(\"4k3/8/8/8/8/5N2/8/1N2K3 w - - 0 1\")",
        "    assert san_of(board, \"b1d2\") == \"Nbd2\"",
        "    assert san_of(board, \"f3d2\") == \"Nfd2\"",
        "",
        "",
        "def test_disambiguation_by_rank() -> None:",
        "    # Rooks on e1 and e5 can both reach e2 (same file -> rank digit).",
        "    board = board_from_fen(\"7k/8/8/4R3/8/8/8/4R1K1 w - - 0 1\")",
        "    assert san_of(board, \"e1e2\") == \"R1e2\"",
        "    assert san_of(board, \"e5e2\") == \"R5e2\"",
        "",
        "",
        "def test_disambiguation_full_square() -> None:",
        "    # Queens a1, h1, h4 can all reach e1; h1 shares file with h4 and rank",
        "    # with a1, so it needs its full origin square.",
        "    board = board_from_fen(\"4k3/8/8/8/7Q/8/6K1/Q6Q w - - 0 1\")",
        "    assert san_of(board, \"h1e1\") == \"Qh1e1\"",
        "    assert san_of(board, \"h4e1\") == \"Q4e1\"",
        "    assert san_of(board, \"a1e1\") == \"Qae1\"",
        "",
        "",
        "def test_promotions() -> None:",
        "    board = board_from_fen(\"4k3/4P3/8/8/8/8/8/4K3 w - - 0 1\")",
        "    assert san_of(board, \"e7e8q\") == \"e8=Q\"",
        "    assert san_of(board, \"e7e8n\") == \"e8=N\"",
        "    capture = board_from_fen(\"3rk3/4P3/8/8/8/8/8/4K3 w - - 0 1\")",
        "    assert san_of(capture, \"e7d8n\") == \"exd8=N\"",
        "    assert san_of(capture, \"e7d8q\") == \"exd8=Q\"",
        "",
        "",
        "def test_castling_san() -> None:",
        "    board = board_from_fen(OPEN_CASTLING)",
        "    assert san_of(board, \"e1g1\") == \"O-O\"",
        "    assert san_of(board, \"e1c1\") == \"O-O-O\"",
        "",
        "",
        "def test_castling_with_check_suffix() -> None:",
        "    # After O-O the f1 rook checks the king on f8.",
        "    board = board_from_fen(\"5k1r/8/8/8/8/8/8/R3K2R w KQ - 0 1\")",
        "    assert san_of(board, \"e1g1\") == \"O-O+\"",
        "",
        "",
        "def test_check_and_mate_suffixes() -> None:",
        "    game = Game()",
        "    game.play_uci(\"f2f3\")",
        "    game.play_uci(\"e7e5\")",
        "    game.play_uci(\"g2g4\")",
        "    board = game.board",
        "    assert san_of(board, \"d8h4\") == \"Qh4#\"",
        "",
        "",
        "def test_san_to_move_simple() -> None:",
        "    board = board_from_fen(START_FEN)",
        "    assert san_to_move(board, \"Nf3\").to_uci() == \"g1f3\"",
        "    assert san_to_move(board, \"e4\").to_uci() == \"e2e4\"",
        "",
        "",
        "def test_san_to_move_tolerates_annotations() -> None:",
        "    game = Game()",
        "    game.play_uci(\"f2f3\")",
        "    game.play_uci(\"e7e5\")",
        "    game.play_uci(\"g2g4\")",
        "    board = game.board",
        "    for text in (\"Qh4\", \"Qh4#\", \"Qh4+\", \"Qh4!?\", \"Qh4#?\"):",
        "        assert san_to_move(board, text).to_uci() == \"d8h4\"",
        "",
        "",
        "def test_san_to_move_capture_and_disambiguation() -> None:",
        "    board = board_from_fen(",
        "        \"rnbqkbnr/ppp1pppp/8/3p4/4P3/8/PPPP1PPP/RNBQKBNR w KQkq d6 0 2\"",
        "    )",
        "    assert san_to_move(board, \"exd5\").to_uci() == \"e4d5\"",
        "    knights = board_from_fen(\"4k3/8/8/8/8/5N2/8/1N2K3 w - - 0 1\")",
        "    assert san_to_move(knights, \"Nbd2\").to_uci() == \"b1d2\"",
        "    assert san_to_move(knights, \"Nfd2\").to_uci() == \"f3d2\"",
        "    rooks = board_from_fen(\"7k/8/8/4R3/8/8/8/4R1K1 w - - 0 1\")",
        "    assert san_to_move(rooks, \"R1e2\").to_uci() == \"e1e2\"",
        "    queens = board_from_fen(\"4k3/8/8/8/7Q/8/6K1/Q6Q w - - 0 1\")",
        "    assert san_to_move(queens, \"Qh1e1\").to_uci() == \"h1e1\"",
        "",
        "",
        "def test_san_to_move_promotions() -> None:",
        "    board = board_from_fen(\"4k3/4P3/8/8/8/8/8/4K3 w - - 0 1\")",
        "    assert san_to_move(board, \"e8=Q\").to_uci() == \"e7e8q\"",
        "    assert san_to_move(board, \"e8=q\").to_uci() == \"e7e8q\"",
        "    capture = board_from_fen(\"3rk3/4P3/8/8/8/8/8/4K3 w - - 0 1\")",
        "    assert san_to_move(capture, \"exd8=N\").to_uci() == \"e7d8n\"",
        "",
        "",
        "def test_san_to_move_castling_accepts_zeros() -> None:",
        "    board = board_from_fen(OPEN_CASTLING)",
        "    for text in (\"O-O\", \"0-0\", \"o-o\"):",
        "        assert san_to_move(board, text).to_uci() == \"e1g1\"",
        "    for text in (\"O-O-O\", \"0-0-0\", \"o-o-o\"):",
        "        assert san_to_move(board, text).to_uci() == \"e1c1\"",
        "",
        "",
        "def test_san_to_move_rejects_illegal_and_ambiguous() -> None:",
        "    board = board_from_fen(START_FEN)",
        "    with pytest.raises(ValueError, match=\"illegal\"):",
        "        san_to_move(board, \"Ke2\")  # the king cannot move to e2 at start",
        "    with pytest.raises(ValueError, match=\"unknown\"):",
        "        san_to_move(board, \"Zz9\")",
        "    knights = board_from_fen(\"4k3/8/8/8/8/5N2/8/1N2K3 w - - 0 1\")",
        "    with pytest.raises(ValueError, match=\"ambiguous\"):",
        "        san_to_move(knights, \"Nd2\")  # both knights can reach d2",
        "",
        "",
        "def test_san_roundtrip_on_legal_moves() -> None:",
        "    for fen in (START_FEN, KIWIPETE, POS4):",
        "        board = board_from_fen(fen)",
        "        for move in legal_moves(board):",
        "            san = move_to_san(board, move)",
        "            assert san_to_move(board, san) == move, f\"{fen}: {move.to_uci()} -> {san}\"",
        ""
      ]
    }
  }
