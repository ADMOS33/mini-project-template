        "def _play_notation(game: Game, text: str) -> Move:",
        "    \"\"\"Play a move given in UCI (``e2e4``) or SAN (``Nf3``) notation.\"\"\"",
        "    try:",
        "        uci_move = Move.from_uci(text)",
        "    except ValueError:",
        "        uci_move = None",
        "    if uci_move is not None:",
        "        try:",
        "            return game.play_uci(uci_move.to_uci())",
