        "            f'font-size=\"11\" fill=\"#9a968f\">{r}</text>'",
        "        )",
        "    parts.append(\"</svg>\")",
        "    OUT.parent.mkdir(parents=True, exist_ok=True)",
        "    OUT.write_text(\"\\n\".join(parts), encoding=\"utf-8\")",
