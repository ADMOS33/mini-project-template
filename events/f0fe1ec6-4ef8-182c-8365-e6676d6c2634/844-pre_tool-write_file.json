        "\"\"\"Render the initial board as a standalone SVG using the real web/pieces/*.svg.\"\"\"",
        "import re",
        "from pathlib import Path",
        "",
        "ROOT = Path(\"/home/dilos/A3/agentic/mini-project-template\")",
        "OUT = ROOT / \"docs/screenshots/board-initial.svg\"",
        "CELL = 45",
