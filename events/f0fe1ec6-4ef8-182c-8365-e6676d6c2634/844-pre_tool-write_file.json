        "SIZE = 8 * CELL + 2 * PAD",
        "",
        "FEN_START = \"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR\"",
        "",
        "",
        "def piece_inner(path: Path) -> str:",
        "    svg = path.read_text(encoding=\"utf-8\")",
        "    body = svg.split(\">\", 1)[1].rsplit(\"</svg>\", 1)[0]",
        "    return body.strip()",
        "",
        "",
        "def main() -> None:",
        "    board = {}",
        "    for i, row in enumerate(FEN_START.split(\"/\")):",
        "        rank = 8 - i",
        "        file = 0",
        "        for ch in row:",
        "            if ch.isdigit():",
        "                file += int(ch)",
        "            else:",
        "                board[(file, rank)] = ch",
        "                file += 1",
        "",
        "    parts = [",
        "        f'<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 {SIZE} {SIZE}\" '",
        "        f'width=\"{SIZE}\" height=\"{SIZE}\" role=\"img\" aria-label=\"Échiquier initial\">',",
        "        f'<rect width=\"{SIZE}\" height=\"{SIZE}\" fill=\"#161512\"/>',",
        "    ]",
        "    # squares",
        "    for f in range(8):",
        "        for r in range(1, 9):",
        "            x = PAD + f * CELL",
        "            y = PAD + (8 - r) * CELL",
        "            color = \"#ebecd0\" if (f + r) % 2 == 0 else \"#739552\"",
        "            parts.append(f'<rect x=\"{x}\" y=\"{y}\" width=\"{CELL}\" height=\"{CELL}\" fill=\"{color}\"/>')",
        "    # pieces",
        "    for (f, r), sym in board.items():",
        "        color = \"w\" if sym.isupper() else \"b\"",
        "        inner = piece_inner(ROOT / f\"web/pieces/{color}{sym.upper()}.svg\")",
        "        x = PAD + f * CELL",
        "        y = PAD + (8 - r) * CELL",
        "        parts.append(f'<g transform=\"translate({x},{y})\">{inner}</g>')",
        "    # coordinates",
        "    for f in range(8):",
        "        x = PAD + f * CELL + CELL / 2",
        "        parts.append(",
        "            f'<text x=\"{x}\" y=\"{PAD - 8}\" text-anchor=\"middle\" font-family=\"Inter, system-ui, sans-serif\" '",
        "            f'font-size=\"11\" fill=\"#9a968f\">{chr(ord(\"a\") + f)}</text>'",
        "        )",
        "        parts.append(",
        "            f'<text x=\"{x}\" y=\"{PAD + 8 * CELL + 20}\" text-anchor=\"middle\" font-family=\"Inter, system-ui, sans-serif\" '",
        "            f'font-size=\"11\" fill=\"#9a968f\">{chr(ord(\"a\") + f)}</text>'",
        "        )",
        "    for r in range(1, 9):",
        "        y = PAD + (8 - r) * CELL + CELL / 2 + 4",
        "        parts.append(",
        "            f'<text x=\"{PAD - 10}\" y=\"{y}\" text-anchor=\"middle\" font-family=\"Inter, system-ui, sans-serif\" '",
        "            f'font-size=\"11\" fill=\"#9a968f\">{r}</text>'",
        "        )",
        "        parts.append(",
