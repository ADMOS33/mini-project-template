      "content": [
        "\"\"\"Play a full game using ONLY the `chess` CLI in --json mode.",
        "",
        "The agent (this script) only *chooses* among the legal moves returned by",
        "`chess moves --json`; all rules come from the engine via the CLI.",
        "Agent = White, computer = Black via `chess ai-move --depth 2`.",
        "\"\"\"",
        "import json",
        "import subprocess",
        "import sys",
        "",
        "CWD = \"/home/dilos/A3/agentic/mini-project-template\"",
        "STATE = \"/tmp/example_game.json\"",
        "CHESS = [f\"{CWD}/.venv/bin/chess\", \"--state\", STATE]",
        "",
        "",
        "def cli(*args):",
        "    r = subprocess.run([*CHESS, *args, \"--json\"], capture_output=True, text=True, cwd=CWD)",
        "    out = r.stdout.strip()",
        "    data = json.loads(out) if out else {}",
        "    return r.returncode, data",
        "",
        "",
        "VAL = {\"p\": 1, \"n\": 3, \"b\": 3, \"r\": 5, \"q\": 9, \"k\": 0}",
        "",
        "",
        "def squares_from_fen(fen):",
        "    board = {}",
        "    for i, row in enumerate(fen.split()[0].split(\"/\")):",
        "        rank = 8 - i",
        "        file = 0",
        "        for ch in row:",
        "            if ch.isdigit():",
        "                file += int(ch)",
        "            else:",
        "                board[chr(ord(\"a\") + file) + str(rank)] = ch",
        "                file += 1",
        "    return board",
        "",
        "",
        "def choose_move(turn):",
        "    _, mv = cli(\"moves\")",
        "    moves = mv[\"moves\"]",
        "    _, bd = cli(\"board\")",
        "    board = squares_from_fen(bd[\"fen\"])",
        "    white = turn == \"w\"",
        "",
        "    def piece_color(sym):",
        "        return \"w\" if sym.isupper() else \"b\"",
        "",
        "    def score(uci):",
        "        frm, to = uci[0:2], uci[2:4]",
        "        s = 0.0",
        "        target = board.get(to)",
        "        if target and piece_color(target) != turn:",
        "            s += 10 * VAL[target.lower()]  # capture: MVV",
        "            attacker = board.get(frm)",
        "            if attacker:",
        "                s -= VAL[attacker.lower()] / 10.0  # LVA",
        "        if len(uci) == 5:  # promotion",
        "            s += 10 * VAL[uci[4]]",
        "        # small central bonus",
        "        if to in (\"d4\", \"e4\", \"d5\", \"e5\", \"c4\", \"f4\", \"c5\", \"f5\"):",
        "            s += 0.5",
        "        return s",
        "",
        "    return max(moves, key=score)",
        "",
        "",
        "def main():",
        "    rc, d = cli(\"new\")",
        "    assert rc == 0 and d.get(\"ok\"), d",
        "    n = 0",
        "    while True:",
        "        rc, st = cli(\"status\")",
        "        if st[\"result\"] != \"ongoing\":",
        "            print(\"FINAL:\", json.dumps({k: st[k] for k in (\"result\", \"winner\", \"turn\", \"in_check\", \"fen\")}))",
        "            break",
        "        if st[\"turn\"] == \"w\":",
        "            uci = choose_move(\"w\")",
        "            rc, d = cli(\"move\", uci)",
        "            if rc != 0:",
        "                # friction point: illegal move chosen -> fall back to first legal",
        "                print(\"MOVE ERROR:\", d, file=sys.stderr)",
        "                _, mv = cli(\"moves\")",
        "                uci = mv[\"moves\"][0]",
        "                rc, d = cli(\"move\", uci)",
        "                assert rc == 0, d",
        "            n += 1",
        "        else:",
        "            rc, d = cli(\"ai-move\", \"--depth\", \"2\")",
        "            assert rc == 0 and d.get(\"ok\"), d",
        "            n += 1",
        "        if n > 400:",
        "            print(\"ABORT: too many plies\", file=sys.stderr)",
        "            sys.exit(1)",
        "    rc, pgn = cli(\"pgn\")",
        "    print(pgn[\"pgn\"] if isinstance(pgn, dict) and \"pgn\" in pgn else pgn)",
        "",
        "",
        "if __name__ == \"__main__\":",
        "    main()",
        ""
      ]
    },
