        "document.getElementById(\"btn-flip\").addEventListener(\"click\", () => {",
        "  state.flipped = !state.flipped;",
        "  lsSet(\"chess.flip\", state.flipped ? \"1\" : \"0\");",
        "  render();",
        "  renderPlayers();",
        "});"
      ]
