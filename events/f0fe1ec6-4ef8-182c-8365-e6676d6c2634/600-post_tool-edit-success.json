        "        assert exc.value.code == 400",
        "        with urllib.request.urlopen(base + \"/\", timeout=5) as resp:  # web UI",
        "            html = resp.read()",
        "        assert resp.status == 200 and b\"<html\" in html.lower()",
        "    finally:",
        "        proc.terminate()",
        "        proc.wait(timeout=10)"
