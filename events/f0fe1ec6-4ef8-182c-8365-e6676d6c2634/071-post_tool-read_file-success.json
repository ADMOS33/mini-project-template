      "content": [
        "\"\"\"Negamax search with alpha-beta pruning over the engine's legal moves.\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from chess.engine.board import Board",
        "from chess.engine.move import Move",
        "from chess.engine.movegen import apply_move, is_square_attacked, legal_moves",
        "from chess.engine.pieces import Color, PieceType",
        "from chess.ai.evaluation import VALUES, evaluate",
        "",
        "MATE_SCORE = 100_000",
        "",
        "",
        "def _evaluate_for_side_to_move(board: Board) -> int:",
        "    \"\"\"Evaluation in centipawns from the side-to-move's perspective.\"\"\"",
        "    score = evaluate(board)",
        "    return score if board.turn is Color.WHITE else -score",
        "",
        "",
        "def _ordered_moves(board: Board) -> list[Move]:",
        "    \"\"\"Legal moves, captures first (MVV-LVA), to improve alpha-beta pruning.\"\"\"",
        "    moves = legal_moves(board)",
        "",
        "    def order(move: Move) -> int:",
        "        victim = board.piece_at(move.to_sq)",
        "        if victim is None:",
        "            return 0",
        "        attacker = board.piece_at(move.from_sq)",
        "        return 10 * VALUES[victim.type] - (VALUES[attacker.type] if attacker else 0)",
        "",
        "    return sorted(moves, key=order, reverse=True)",
        "",
        "",
        "def negamax(board: Board, depth: int, alpha: int, beta: int) -> int:",
        "    \"\"\"Best score for the side to move, in centipawns (negamax convention).\"\"\"",
        "    if depth == 0:",
        "        return _evaluate_for_side_to_move(board)",
        "    moves = _ordered_moves(board)",
        "    if not moves:",
        "        if is_square_attacked(board, board.king_square(board.turn), board.turn.opposite):",
        "            return -MATE_SCORE - depth  # checkmated; deeper mate = worse",
        "        return 0  # stalemate",
        "    best = -MATE_SCORE * 2",
        "    for move in moves:",
        "        score = -negamax(apply_move(board, move), depth - 1, -beta, -alpha)",
        "        if score > best:",
        "            best = score",
        "        if best > alpha:",
        "            alpha = best",
        "        if alpha >= beta:",
        "            break",
        "    return best",
        "",
        "",
        "def best_move(board: Board, depth: int = 3) -> tuple[Move, int]:",
        "    \"\"\"Best move for the side to move at the given depth, with its score.\"\"\"",
        "    if depth < 1:",
        "        raise ValueError(f\"depth must be >= 1, got {depth}\")",
        "    best: Move | None = None",
        "    best_score = -MATE_SCORE * 2",
        "    alpha = -MATE_SCORE * 2",
        "    for move in _ordered_moves(board):",
        "        score = -negamax(apply_move(board, move), depth - 1, -MATE_SCORE * 2, -alpha)",
        "        if score > best_score:",
        "            best_score = score",
        "            best = move",
        "        if score > alpha:",
        "            alpha = score",
        "    if best is None:",
        "        raise ValueError(\"no legal move available\")",
        "    return best, best_score",
        ""
