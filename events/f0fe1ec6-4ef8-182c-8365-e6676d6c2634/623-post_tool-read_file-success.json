      "content": [
        "/* Chess web UI — modern dark theme, 3-column responsive layout. */",
        "",
        ":root {",
        "  --bg: #1b1a17;",
        "  --panel: #262421;",
        "  --panel-border: #3a3733;",
        "  --text: #ececec;",
        "  --muted: #a8a29e;",
        "  --accent: #7fa650;",
        "  --accent-hover: #93bd60;",
        "  --light-square: #eeeed2;",
        "  --dark-square: #769656;",
        "  --highlight: rgba(255, 213, 79, 0.45);",
        "  --danger: #e5484d;",
        "}",
        "",
        "* {",
        "  box-sizing: border-box;",
        "}",
        "",
        "body {",
        "  margin: 0;",
        "  font-family: system-ui, -apple-system, \"Segoe UI\", sans-serif;",
        "  background: var(--bg);",
        "  color: var(--text);",
        "}",
        "",
        ".app {",
        "  max-width: 1280px;",
        "  margin: 0 auto;",
        "  padding: 0.75rem 1.25rem 2rem;",
        "}",
        "",
        ".topbar {",
        "  display: flex;",
        "  align-items: baseline;",
        "  gap: 0.75rem;",
        "  flex-wrap: wrap;",
        "}",
        "",
        ".topbar h1 {",
        "  font-size: 1.5rem;",
        "  margin: 0.5rem 0;",
        "}",
        "",
        ".subtitle {",
        "  color: var(--muted);",
        "  font-size: 0.9rem;",
        "}",
        "",
        "/* --- 3-column layout (stacked on narrow screens) --- */",
        "",
        ".layout {",
        "  display: grid;",
        "  grid-template-columns: 250px minmax(320px, 640px) 250px;",
        "  gap: 1.25rem;",
        "  align-items: start;",
        "  justify-content: center;",
        "  margin-top: 0.75rem;",
        "}",
        "",
        "@media (max-width: 1080px) {",
        "  .layout {",
        "    grid-template-columns: minmax(300px, 640px);",
        "  }",
        "  .board-area {",
        "    order: -1;",
        "  }",
        "}",
        "",
        ".panel {",
        "  background: var(--panel);",
        "  border: 1px solid var(--panel-border);",
        "  border-radius: 12px;",
        "  padding: 0.9rem;",
        "  display: flex;",
        "  flex-direction: column;",
        "  gap: 0.9rem;",
        "}",
        "",
        ".block {",
        "  display: flex;",
        "  flex-direction: column;",
        "  gap: 0.5rem;",
        "}",
        "",
        ".panel h2 {",
        "  font-size: 0.75rem;",
        "  text-transform: uppercase;",
        "  letter-spacing: 0.08em;",
        "  color: var(--muted);",
        "  margin: 0;",
        "}",
        "",
        "/* --- Players --- */",
        "",
        ".player-card {",
        "  display: flex;",
        "  align-items: center;",
        "  justify-content: space-between;",
        "  gap: 0.5rem;",
        "  padding: 0.45rem 0.6rem;",
        "  border-radius: 8px;",
        "  background: #2e2b27;",
        "  border: 1px solid transparent;",
        "  font-weight: 600;",
        "}",
        "",
        ".player-card.active {",
        "  border-color: var(--accent);",
        "}",
        "",
        ".player-card .dot {",
        "  color: var(--accent);",
        "}",
        "",
        ".player-card .clock {",
        "  font-family: ui-monospace, monospace;",
        "  font-weight: 500;",
        "  color: var(--muted);",
        "}",
        "",
        ".player-card .clock.low {",
        "  color: var(--danger);",
        "}",
        "",
        ".captured {",
        "  min-height: 1.6rem;",
        "  font-size: 1.25rem;",
        "  letter-spacing: 0.05em;",
        "  line-height: 1.4;",
        "  padding: 0 0.2rem;",
        "}",
        "",
        ".captured .adv {",
        "  font-size: 0.8rem;",
        "  color: var(--muted);",
        "  font-family: ui-monospace, monospace;",
        "}",
        "",
        "/* --- Board --- */",
        "",
        ".board-area {",
        "  display: flex;",
        "  flex-direction: column;",
        "  align-items: center;",
        "  gap: 0.6rem;",
        "}",
        "",
        ".board {",
        "  display: grid;",
        "  grid-template-columns: repeat(8, 1fr);",
        "  width: min(100%, 640px);",
        "  aspect-ratio: 1;",
        "  border-radius: 10px;",
        "  overflow: hidden;",
        "  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.55), 0 3px 10px rgba(0, 0, 0, 0.5);",
        "  touch-action: none;",
        "}",
        "",
        ".square {",
        "  position: relative;",
        "  display: flex;",
        "  align-items: center;",
        "  justify-content: center;",
        "  cursor: pointer;",
        "  aspect-ratio: 1;",
        "}",
        "",
        ".square.light {",
        "  background: var(--light-square);",
        "}",
        "",
        ".square.dark {",
        "  background: var(--dark-square);",
        "}",
        "",
        ".square.selected {",
        "  outline: 3px solid gold;",
        "  outline-offset: -3px;",
        "}",
        "",
        ".square.last-move {",
        "  background-image: linear-gradient(var(--highlight), var(--highlight));",
        "}",
        "",
        ".square.in-check {",
        "  background-image: radial-gradient(circle, rgba(229, 72, 77, 0.85) 20%, rgba(229, 72, 77, 0.25) 60%, transparent 75%);",
        "}",
        "",
        "/* Legal-move hints: dot on empty squares, ring on captures. */",
        ".square.hint::after {",
        "  content: \"\";",
        "  position: absolute;",
        "  width: 26%;",
        "  height: 26%;",
        "  border-radius: 50%;",
        "  background: rgba(20, 20, 20, 0.28);",
        "}",
        "",
        ".square.hint-capture::after {",
        "  content: \"\";",
        "  position: absolute;",
        "  inset: 4%;",
        "  border-radius: 50%;",
        "  border: calc(var(--sq, 64px) * 0.07) solid rgba(20, 20, 20, 0.35);",
        "  background: transparent;",
        "}",
        "",
        "/* --- Pieces --- */",
        "",
        ".piece {",
        "  font-size: calc(var(--sq, 64px) * 0.74);",
        "  line-height: 1;",
        "  user-select: none;",
        "  pointer-events: none;",
        "}",
        "",
        "/* White pieces: white fill with a dark outline; black pieces: near-black",
        "   fill with a light outline, so both stay readable on either square color. */",
        ".piece.white {",
        "  color: #ffffff;",
        "  text-shadow: 0 0 2px #1a1a1a, 0 0 4px rgba(0, 0, 0, 0.55);",
        "}",
        "",
        ".piece.black {",
        "  color: #1a1a1a;",
        "  text-shadow: 0 0 2px rgba(255, 255, 255, 0.8), 0 0 3px rgba(255, 255, 255, 0.45);",
        "}",
        "",
        ".piece.drag-ghost {",
        "  position: absolute;",
        "  z-index: 10;",
        "  pointer-events: none;",
        "  transform: translate(-50%, -50%);",
        "}",
        "",
        "/* --- Coordinates --- */",
        "",
        ".coord {",
        "  position: absolute;",
        "  font-size: calc(var(--sq, 64px) * 0.16);",
        "  font-weight: 700;",
        "  opacity: 0.85;",
        "  pointer-events: none;",
        "  line-height: 1;",
        "}",
        "",
        ".coord.rank {",
        "  top: 3px;",
        "  left: 4px;",
        "}",
        "",
        ".coord.file {",
        "  bottom: 2px;",
        "  right: 4px;",
        "}",
        "",
        ".square.light .coord {",
        "  color: #769656;",
        "}",
        "",
        ".square.dark .coord {",
        "  color: #eeeed2;",
        "}",
        "",
        "/* --- Status, buttons, history --- */",
        "",
        ".status {",
        "  min-height: 1.5rem;",
        "  color: var(--muted);",
        "  font-family: ui-monospace, SFMono-Regular, monospace;",
        "  font-size: 0.85rem;",
        "  text-align: center;",
        "}",
        "",
        "button,",
        "select,",
        "textarea {",
        "  font: inherit;",
        "  color: var(--text);",
        "  background: #33302b;",
        "  border: 1px solid var(--panel-border);",
        "  border-radius: 8px;",
        "  padding: 0.4rem 0.7rem;",
        "}",
        "",
        "button {",
        "  cursor: pointer;",
        "  background: var(--accent);",
        "  border-color: transparent;",
        "  color: #fff;",
        "  font-weight: 600;",
        "}",
        "",
        "button:hover {",
        "  background: var(--accent-hover);",
        "}",
        "",
        "button.secondary {",
        "  background: #33302b;",
        "  border-color: var(--panel-border);",
        "  font-weight: 500;",
        "}",
        "",
        "button.secondary:hover {",
        "  background: #403c35;",
        "}",
        "",
        ".btn-row {",
        "  display: flex;",
        "  flex-wrap: wrap;",
        "  gap: 0.4rem;",
        "}",
        "",
        ".history {",
        "  list-style: none;",
        "  margin: 0;",
        "  padding: 0;",
        "  max-height: 340px;",
        "  overflow-y: auto;",
        "  display: grid;",
        "  grid-template-columns: 2rem 1fr 1fr;",
        "  font-family: ui-monospace, SFMono-Regular, monospace;",
        "  font-size: 0.85rem;",
        "  gap: 0.1rem 0.4rem;",
        "}",
        "",
        ".history li {",
        "  padding: 0.1rem 0.3rem;",
        "  border-radius: 4px;",
        "}",
        "",
        ".history li.num {",
        "  color: var(--muted);",
        "}",
        "",
        ".history li.move {",
        "  cursor: pointer;",
        "}",
        "",
        ".history li.move:hover {",
        "  background: #3a3733;",
        "}",
        "",
        ".history li.move.current {",
        "  background: var(--accent);",
        "  color: #fff;",
        "}",
        "",
        ".history li.empty {",
        "  grid-column: 1 / -1;",
        "  color: var(--muted);",
        "}",
        "",
        "/* --- Modals (promotion, game over) --- */",
        "",
        ".modal {",
        "  position: fixed;",
        "  inset: 0;",
        "  background: rgba(0, 0, 0, 0.6);",
        "  display: flex;",
        "  align-items: center;",
        "  justify-content: center;",
        "  z-index: 100;",
        "}",
        "",
        ".modal.hidden {",
        "  display: none;",
        "}",
        "",
        ".modal-box {",
        "  background: var(--panel);",
        "  border: 1px solid var(--panel-border);",
        "  border-radius: 14px;",
        "  padding: 1.25rem 1.5rem;",
        "  display: flex;",
        "  flex-direction: column;",
        "  align-items: center;",
        "  gap: 0.9rem;",
        "  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);",
        "}",
        "",
        ".modal-box h3 {",
        "  margin: 0;",
        "}",
        "",
        ".promo-choices {",
        "  display: flex;",
        "  gap: 0.6rem;",
        "}",
        "",
        ".promo-btn {",
        "  font-size: 2.2rem;",
        "  width: 64px;",
        "  height: 64px;",
        "  padding: 0;",
        "  line-height: 1;",
        "  background: #33302b;",
        "  border: 1px solid var(--panel-border);",
        "}",
        "",
        ".promo-btn:hover {",
        "  background: var(--accent);",
        "}",
        "",
        "/* --- Options, import/export, review bar, thinking --- */",
        "",
        ".opt {",
        "  display: flex;",
        "  align-items: center;",
        "  gap: 0.4rem;",
        "  font-size: 0.9rem;",
        "  color: var(--text);",
        "}",
        "",
        "select,",
        "textarea {",
        "  width: 100%;",
        "}",
        "",
        "textarea {",
        "  resize: vertical;",
        "  font-family: ui-monospace, SFMono-Regular, monospace;",
        "  font-size: 0.8rem;",
        "}",
        "",
        ".thinking {",
        "  color: var(--accent-hover);",
        "  font-size: 0.85rem;",
        "  font-style: italic;",
        "}",
        "",
        ".thinking.hidden,",
        ".review-bar.hidden,",
        ".modal.hidden {",
        "  display: none;",
        "}",
        "",
        ".review-bar {",
        "  display: flex;",
        "  align-items: center;",
        "  gap: 0.35rem;",
        "  background: var(--panel);",
        "  border: 1px solid var(--panel-border);",
        "  border-radius: 10px;",
        "  padding: 0.35rem 0.6rem;",
        "}",
        "",
        ".review-bar button {",
        "  padding: 0.15rem 0.55rem;",
        "  font-size: 0.95rem;",
        "}",
        "",
        "#review-label {",
        "  font-family: ui-monospace, monospace;",
        "  font-size: 0.8rem;",
        "  color: var(--muted);",
        "  min-width: 6.5rem;",
        "  text-align: center;",
        "}",
        "",
        ".captured .adv {",
        "  font-size: 0.8rem;",
        "  color: var(--accent-hover);",
        "  font-family: ui-monospace, monospace;",
        "}",
        ""
      ],
