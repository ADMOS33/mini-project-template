        "cd /Users/rafiq/3A/projet-AI/mini-project-template && .venv/bin/python - <<'EOF'",
        "import sys, time",
        "sys.path.insert(0, \".\")",
        "from chess.ai.mate import find_mates, can_mate_in",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import is_square_attacked",
        "from chess.engine.pieces import Color",
        "",
        "def make(sqs, turn):",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows)+f\" {turn} - - 0 1\")",
        "",
        "CORNERS=[0,7,56,63]",
        "t0=time.time(); total=0; hits=[]",
        "for kb in CORNERS:",
        "    kf,kr=kb%8,kb//8",
        "    for ks in range(64):",
        "        if max(abs(ks%8-kf),abs(ks//8-kr))!=2: continue",
        "        for qs in range(64):",
        "            if qs in (kb,ks): continue",
        "            if time.time()-t0>100: break",
        "            sqs=[None]*64; sqs[kb]=\"k\"; sqs[ks]=\"K\"; sqs[qs]=\"Q\"",
        "            try: L=make(sqs,\"w\")",
        "            except ValueError: continue",
        "            if is_square_attacked(L, L.king_square(Color.BLACK), Color.WHITE): continue",
        "            total+=1",
        "            if find_mates(L,2): continue",
        "            if not can_mate_in(L,3): continue",
        "            ms=find_mates(L,3)",
        "            if len(ms)==1:",
        "                hits.append((board_to_fen(L), ms[0].to_uci()))",
        "                print(\"L3:\", board_to_fen(L), ms[0].to_uci(), flush=True)",
        "    if time.time()-t0>100: break",
        "print(f\"total={total} l3-hits={len(hits)} in {time.time()-t0:.0f}s\")",
        "EOF"
      ]
    }
  }
