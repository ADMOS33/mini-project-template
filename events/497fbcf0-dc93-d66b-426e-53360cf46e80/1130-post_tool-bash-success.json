        "\"\"\"Pydantic request schemas for the HTTP API.\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from pydantic import BaseModel, Field",
        "",
        "",
        "class MoveRequest(BaseModel):",
        "    \"\"\"Body of ``POST /api/move``.\"\"\"",
        "",
        "    move: str = Field(..., examples=[\"e2e4\", \"e7e8q\"], description=\"Move in UCI notation\")",
        "",
        "",
        "class LoadRequest(BaseModel):",
        "    \"\"\"Body of ``POST /api/load``.\"\"\"",
        "",
        "    fen: str = Field(",
        "        ...,",
        "        examples=[\"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1\"],",
        "        description=\"FEN of the position to load\",",
        "    )",
        "",
        "",
        "class PgnRequest(BaseModel):",
        "    \"\"\"Body of ``POST /api/load-pgn``.\"\"\"",
        "",
        "    pgn: str = Field(..., examples=['[Event \"Casual\"]\\n\\n1. e4 e5 2. Nf3 Nc6 *'])",
        "",
        "",
        "class AiMoveRequest(BaseModel):",
        "    \"\"\"Body of ``POST /api/ai-move``.\"\"\"",
        "",
        "    depth: int = Field(3, ge=1, le=6, description=\"Search depth (1-4 in the UI)\")",
        "",
        "",
        "class FlagRequest(BaseModel):",
        "    \"\"\"Body of ``POST /api/flag``: the given color loses on time.\"\"\"",
        "",
        "    color: str = Field(..., pattern=\"^[wb]$\", examples=[\"w\"])",
        "        \"moves\": [m.to_uci() for m in game.moves],",
        "        \"status\": game.status(),",
        "    }",
        "",
        "",
        "@app.get(\"/api/eval\")",
        "def get_eval() -> dict:",
        "    \"\"\"Static evaluation in centipawns, from the side to move's perspective.\"\"\"",
        "    game = _load()",
        "    return {",
        "        \"score\": evaluate(game.board),",
        "        \"turn\": str(game.board.turn),",
        "        \"fen\": board_to_fen(game.board),",
        "    }",
        "",
        "",
        "@app.post(\"/api/ai-move\")",
        "def post_ai_move(req: AiMoveRequest) -> dict:",
        "    \"\"\"Let the computer (minimax + alpha-beta) play the side to move.\"\"\"",
        "    game = _load()",
        "    if game.status()[\"result\"] != \"ongoing\":",
        "        raise HTTPException(status_code=400, detail=\"game is over\")",
        "    depth = max(1, min(req.depth, 6))",
        "    start = time.perf_counter()",
        "    move, score, nodes = best_move(game.board, depth)",
        "    time_ms = round((time.perf_counter() - start) * 1000, 1)",
        "    san = move_to_san(game.board, move)",
        "    game.play_uci(move.to_uci())",
        "    _save(game)",
        "    return {",
        "        \"ok\": True,",
        "        \"move\": move.to_uci(),",
        "        \"san\": san,",
        "        \"score\": score,",
        "        \"nodes\": nodes,",
        "        \"time_ms\": time_ms,",
        "        \"depth\": depth,",
        "        \"status\": game.status(),",
        "    }",
        "",
        "",
        "class NoCacheStaticFiles(StaticFiles):",
        "    \"\"\"Static files served with ``Cache-Control: no-cache`` so a browser",
        "    reload never shows a stale version of the web UI.\"\"\"",
        "",
