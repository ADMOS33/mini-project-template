        "    for letter in extras + weak:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is None:",
        "            sqs[s] = letter if (letter in extras) == (strong=='w') else letter.lower()",
        "            if sqs[s] is None: return None",
        "        else: return None",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e='',0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    return '/'.join(rows)+f' {strong} - - 0 1'",
        "found=0; t0=time.time()",
        "for i in range(600):",
        "    fen = make('w', rng.choice([['Q'],['Q','R'],['R','R'],['Q','B']]), rng.choice([['p'],['r'],['p','p'],[]]))",
        "    if fen is None: continue",
        "    try: b = board_from_fen(fen)",
        "    except ValueError: continue",
        "    if can_mate_in(b,1): continue",
        "    score,_ = negamax(b,4,-_INF,_INF)",
        "    if score < MATE_SCORE: continue",
        "    ms = find_mates(b,2)",
        "    if len(ms)==1:",
        "        found+=1",
        "        if found<=5: print('EXACT M2:', board_to_fen(b), ms[0].to_uci())",
        "print(f'600 tries -> {found} exact mate-in-2 in {time.time()-t0:.0f}s')",
