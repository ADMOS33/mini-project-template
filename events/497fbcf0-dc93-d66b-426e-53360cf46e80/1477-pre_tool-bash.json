        "from chess.engine.fen import board_from_fen, board_to_fen",
        "rng = random.Random(11)",
        "EDGE = [s for s in range(64) if s % 8 in (0,7) or s//8 in (0,7)]",
        "def make(strong, extras, weak):",
        "    sqs=[None]*64",
        "    kb = rng.choice(EDGE)",
        "    ks = rng.choice([s for s in range(64) if 1 < max(abs(s%8-kb%8), abs(s//8-kb//8)) <= 2])",
