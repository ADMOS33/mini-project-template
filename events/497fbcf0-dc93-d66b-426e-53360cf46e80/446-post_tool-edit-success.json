        "    sock.close()",
        "    env = dict(os.environ, CHESS_STATE_FILE=str(tmp_path / \".chess_game.json\"))",
        "    proc = subprocess.Popen(",
        "        [sys.executable, \"-m\", \"uvicorn\", \"chess.api.server:app\",",
