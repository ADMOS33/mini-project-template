        "\"\"\"Generate a VERIFIED puzzle database.",
        "",
        "- mate-in-1: hand-crafted candidate FENs, kept only if find_mates(b,1) == [one move].",
        "- mate-in-2/3: random \"queen odds\" games (Black has no queen) scanned with a",
        "  quick negamax filter; kept only if find_mates(b,n) is unique.",
        "Output: /Users/rafiq/.vibe/scratchpad/puzzles_raw.json",
        "\"\"\"",
        "import json, random, sys",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.evaluation import MATE_SCORE, VALUES",
        "from chess.ai.mate import find_mates",
        "from chess.ai.search import _INF, best_move, negamax",
        "from chess.engine.board import Board",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import apply_move",
        "",
        "random.seed(7)",
        "THEME = {\"Q\": \"Mat à la dame\", \"R\": \"Mat à la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aidé\"}",
        "",
        "CANDIDATES_1 = [",
        "    \"rnbqkbnr/pppp1ppp/8/4p3/6P1/5P2/PPPPP2P/RNBQKBNR b KQkq - 0 2\",   # fool's mate Qh4#",
        "    \"r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 4 3\",   # scholar's Qxf7#",
        "    \"r1bqkb1r/pppp1ppp/2n2n2/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 4 4\",  # Qxf7#",
        "    \"6k1/5ppp/8/8/8/8/8/R3K2R w KQ - 0 1\",                               # back rank Ra8#",
        "    \"6k1/5ppp/8/8/8/8/8/2R3K1 w - - 0 1\",                                # Rc8#",
        "    \"6k1/5ppp/8/8/8/8/8/2Q3K1 w - - 0 1\",                                # Qc8#",
        "    \"k7/8/8/8/8/8/1R6/R6K w - - 0 1\",                                   # ladder Rb8#",
        "    \"6rk/6pp/7N/8/8/8/8/7K w - - 0 1\",                                   # smothered Nf7#",
        "    \"3k4/8/3K4/8/8/8/8/7R w - - 0 1\",                                    # Rh8#",
        "    \"7k/8/5K2/8/8/8/8/7R w - - 0 1\",                                     # Rh8#",
        "    \"rnb1kbnr/pppp1ppp/8/4p3/6Pq/5P2/PPPPP2P/RNBQKBNR w KQkq - 1 3\",      # already mated: no mate for white",
        "    \"8/8/8/8/8/5k2/8/4K2R w K - 0 1\",                                    # Rh8+ ... not mate? engine decides",
        "]",
        "",
        "def quick(board, n):",
        "    score, _ = negamax(board, 2 * n, -_INF, _INF)",
        "    return score >= MATE_SCORE",
        "",
        "def mat_balance(board):",
        "    return sum((VALUES[p.type] if p.color.value == \"w\" else -VALUES[p.type])",
        "               for p in board.squares if p)",
        "",
        "def scan_games(n_wanted, n, start_fen, min_mat, max_games=200):",
        "    found, games = [], 0",
        "    while len(found) < n_wanted and games < max_games:",
        "        games += 1",
        "        board = board_from_fen(start_fen)",
        "        for ply in range(60):",
        "            if quick(board, n) and abs(mat_balance(board)) >= min_mat:",
        "                ms = find_mates(board, n)",
        "                if len(ms) == 1:",
        "                    found.append((board_to_fen(board), ms[0].to_uci(),",
        "                                  board.piece_at(ms[0].from_sq).symbol))",
        "                    print(f\"  n={n} #{len(found)}: {board_to_fen(board)} sol={ms[0].to_uci()}\", flush=True)",
        "                    if len(found) >= n_wanted:",
        "                        return found",
        "            try:",
        "                mv, _, _ = best_move(board, 1)",
        "            except ValueError:",
        "                break",
        "            board = apply_move(board, mv)",
        "    return found",
        "",
        "out = {1: [], 2: [], 3: []}",
        "print(\"hand-crafted mate-in-1...\", flush=True)",
        "for fen in CANDIDATES_1:",
        "    b = board_from_fen(fen)",
        "    ms = find_mates(b, 1)",
        "    if len(ms) == 1:",
        "        out[1].append((fen, ms[0].to_uci(), b.piece_at(ms[0].from_sq).symbol))",
        "        print(f\"  n=1 keep: {fen} sol={ms[0].to_uci()}\", flush=True)",
        "    else:",
        "        print(f\"  n=1 drop ({len(ms)} mates): {fen}\", flush=True)",
        "",
        "QUEEN_ODDS = \"rnb1kbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1\"  # Black without queen",
        "print(\"scanning mate-in-1 from queen-odds games...\", flush=True)",
        "out[1] += scan_games(max(0, 12 - len(out[1])), 1, QUEEN_ODDS, 6, 60)",
        "print(\"scanning mate-in-2...\", flush=True)",
        "out[2] = scan_games(12, 2, QUEEN_ODDS, 5, 150)",
        "print(\"scanning mate-in-3...\", flush=True)",
        "out[3] = scan_games(8, 3, QUEEN_ODDS, 7, 80)",
        "",
        "puzzles = [{\"fen\": f, \"solution\": s, \"level\": lv, \"theme\": THEME.get(sym.upper(), \"Mat forcé\")}",
        "           for lv, items in out.items() for f, s, sym in items]",
        "json.dump(puzzles, open(\"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\", \"w\"), indent=2, ensure_ascii=False)",
        "print(f\"TOTAL {len(puzzles)}: l1={len(out[1])} l2={len(out[2])} l3={len(out[3])}\")",
