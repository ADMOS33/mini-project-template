      "content": [
        "\"\"\"Verified puzzle generation: sample sparse endgames, keep positions where",
        "find_mates(board, n) is exactly one move. Bias: defending king on the edge.\"\"\"",
        "import json, random, sys, time",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.evaluation import MATE_SCORE",
        "from chess.ai.mate import find_mates",
        "from chess.ai.search import _INF, negamax",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "",
        "rng = random.Random(99)",
        "THEME = {\"Q\": \"Mat à la dame\", \"R\": \"Mat à la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aidé\"}",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "",
        "def placement(strong, pieces):",
        "    \"\"\"pieces: dict square->letter (strong side, correct case).\"\"\"",
        "    sqs = [None] * 64",
        "    kb = rng.choice(EDGE)",
        "    # strong king within distance 2 of the weak king, not adjacent",
        "    cands = [s for s in range(64)",
        "             if 1 < max(abs(s % 8 - kb % 8), abs(s // 8 - kb // 8)) <= 2]",
        "    ks = rng.choice(cands)",
        "    sqs[kb] = \"k\" if strong == \"w\" else \"K\"",
        "    sqs[ks] = \"K\" if strong == \"w\" else \"k\"",
        "    for s, letter in pieces.items():",
        "        if sqs[s] is None:",
        "            sqs[s] = letter if strong == \"w\" else letter.lower()",
        "        else:",
        "            return None",
        "    rows = []",
        "    for r in range(7, -1, -1):",
        "        row, e = \"\", 0",
        "        for f in range(8):",
        "            p = sqs[r * 8 + f]",
        "            if p is None:",
        "                e += 1",
        "            else:",
        "                if e:",
        "                    row += str(e)",
        "                    e = 0",
        "                row += p",
        "        if e:",
        "            row += str(e)",
        "        rows.append(row)",
        "    return \"/\".join(rows) + f\" {strong} - - 0 1\"",
        "",
        "def sample(piece_letters, strong):",
        "    squares = rng.sample(range(64), len(piece_letters))",
        "    return placement(strong, dict(zip(squares, piece_letters)))",
        "",
        "def quick(b, n):",
        "    score, _ = negamax(b, 2 * n, -_INF, _INF)",
        "    return score >= MATE_SCORE",
        "",
        "def collect(n, wanted, piece_sets, max_tries=20000):",
        "    found, tries = [], 0",
        "    t0 = time.time()",
        "    while len(found) < wanted and tries < max_tries:",
        "        tries += 1",
        "        strong = rng.choice([\"w\", \"b\"])",
        "        letters = rng.choice(piece_sets)",
        "        fen = sample(letters, strong)",
        "        if fen is None:",
        "            continue",
        "        try:",
        "            b = board_from_fen(fen)",
        "        except ValueError:",
        "            continue",
        "        if not quick(b, n):",
        "            continue",
        "        ms = find_mates(b, n)",
        "        if len(ms) == 1:",
        "            found.append({\"fen\": board_to_fen(b), \"solution\": ms[0].to_uci(), \"level\": n,",
        "                          \"theme\": THEME.get(b.piece_at(ms[0].from_sq).symbol.upper(), \"Mat forcé\")})",
        "            print(f\"n={n} #{len(found)} ({tries} tries, {time.time()-t0:.0f}s): {board_to_fen(b)} sol={ms[0].to_uci()}\", flush=True)",
        "    return found",
        "",
        "out = {}",
        "out[1] = collect(1, 12, [[\"Q\"], [\"R\", \"R\"], [\"Q\", \"R\"], [\"Q\", \"B\"], [\"Q\", \"N\"], [\"R\", \"B\"], [\"Q\", \"P\"]], 4000)",
        "out[2] = collect(2, 12, [[\"Q\"], [\"Q\", \"R\"], [\"R\", \"R\"], [\"Q\", \"B\"], [\"Q\", \"N\"]], 20000)",
        "out[3] = collect(3, 8, [[\"Q\"], [\"Q\", \"R\"], [\"R\", \"R\"], [\"Q\", \"B\", \"B\"]], 30000)",
        "puzzles = out[1] + out[2] + out[3]",
        "json.dump(puzzles, open(\"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\", \"w\"), indent=2, ensure_ascii=False)",
        "print(f\"TOTAL {len(puzzles)}: l1={len(out[1])} l2={len(out[2])} l3={len(out[3])}\")",
        ""
      ]
    }
  }
