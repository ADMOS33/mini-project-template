    "tool_input": {
      "file_path": "/Users/rafiq/3A/projet-AI/mini-project-template/tests/test_mcp.py",
      "content": [
        "\"\"\"Tests for the hand-rolled MCP server (chess/mcp/).",
        "",
        "The server runs in a subprocess (``python -m chess.mcp``) and is driven over",
        "its stdio JSON-RPC channel, with CHESS_STATE_FILE pointed at a tmp_path so",
        "tests never touch a real game.",
        "\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "import json",
        "import os",
        "import subprocess",
        "import sys",
        "from pathlib import Path",
        "",
        "import pytest",
        "",
        "ROOT = Path(__file__).resolve().parent.parent",
        "EXPECTED_TOOLS = {",
        "    \"new_game\",",
        "    \"get_board\",",
        "    \"get_status\",",
        "    \"legal_moves\",",
        "    \"play_move\",",
        "    \"ai_move\",",
        "    \"analyze_position\",",
        "    \"get_pgn\",",
        "}",
        "",
        "",
        "class McpClient:",
        "    \"\"\"Minimal JSON-RPC 2.0 client talking to the server over pipes.\"\"\"",
        "",
        "    def __init__(self, state_file: Path):",
        "        env = dict(os.environ, CHESS_STATE_FILE=str(state_file))",
        "        self.proc = subprocess.Popen(",
        "            [sys.executable, \"-m\", \"chess.mcp\"],",
        "            stdin=subprocess.PIPE,",
        "            stdout=subprocess.PIPE,",
        "            stderr=subprocess.PIPE,",
        "            text=True,",
        "            cwd=ROOT,",
        "            env=env,",
        "        )",
        "        self.next_id = 0",
        "",
        "    def send(self, method: str, params: dict | None = None, notification: bool = False) -> dict | None:",
        "        self.next_id += 1",
        "        msg: dict = {\"jsonrpc\": \"2.0\", \"method\": method, \"params\": params or {}}",
        "        if not notification:",
        "            msg[\"id\"] = self.next_id",
        "        assert self.proc.stdin is not None",
        "        self.proc.stdin.write(json.dumps(msg) + \"\\n\")",
        "        self.proc.stdin.flush()",
        "        if notification:",
        "            return None",
        "        assert self.proc.stdout is not None",
        "        line = self.proc.stdout.readline()",
        "        assert line, \"server closed stdout unexpectedly\"",
        "        return json.loads(line)",
        "",
        "    def call(self, name: str, arguments: dict | None = None) -> dict:",
        "        \"\"\"tools/call wrapper; returns the parsed 'result'.\"\"\"",
        "        resp = self.send(\"tools/call\", {\"name\": name, \"arguments\": arguments or {}})",
        "        assert \"result\" in resp, f\"expected a result, got {resp}\"",
        "        return resp[\"result\"]",
        "",
        "    def payload(self, name: str, arguments: dict | None = None) -> tuple[dict, bool]:",
        "        \"\"\"tools/call -> (parsed JSON payload, isError).\"\"\"",
        "        result = self.call(name, arguments)",
        "        assert result[\"content\"] and result[\"content\"][0][\"type\"] == \"text\"",
        "        return json.loads(result[\"content\"][0][\"text\"]), bool(result.get(\"isError\", False))",
        "",
        "    def close(self) -> str:",
        "        assert self.proc.stdin is not None",
        "        self.proc.stdin.close()",
        "        rc = self.proc.wait(timeout=10)",
        "        assert rc == 0",
        "        assert self.proc.stderr is not None",
        "        return self.proc.stderr.read()",
        "",
        "",
        "@pytest.fixture()",
        "def mcp(tmp_path):",
        "    client = McpClient(tmp_path / \".chess_game.json\")",
        "    yield client",
        "    stderr = client.close()",
        "    assert \"[chess-mcp]\" in stderr  # logs go to stderr only",
        "",
        "",
        "def test_initialize_echoes_protocol_version(mcp) -> None:",
        "    resp = mcp.send(\"initialize\", {\"protocolVersion\": \"2025-06-18\", \"clientInfo\": {\"name\": \"t\", \"version\": \"0\"}})",
        "    result = resp[\"result\"]",
        "    assert result[\"protocolVersion\"] == \"2025-06-18\"",
        "    assert result[\"capabilities\"] == {\"tools\": {}}",
        "    assert result[\"serverInfo\"][\"name\"] == \"chess-mcp\"",
        "",
        "",
        "def test_notification_gets_no_response(mcp) -> None:",
        "    assert mcp.send(\"notifications/initialized\", notification=True) is None",
        "    # The next response on stdout must belong to the NEXT request (id 2),",
        "    # proving the notification was not answered.",
        "    resp = mcp.send(\"ping\")",
        "    assert resp == {\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {}}",
        "",
        "",
        "def test_tools_list_has_all_tools_with_input_schema(mcp) -> None:",
        "    result = mcp.send(\"tools/list\")[\"result\"]",
        "    tools = {t[\"name\"]: t for t in result[\"tools\"]}",
        "    assert set(tools) == EXPECTED_TOOLS",
        "    for tool in tools.values():",
        "        assert tool[\"description\"]",
        "        assert tool[\"inputSchema\"][\"type\"] == \"object\"",
        "    assert tools[\"play_move\"][\"inputSchema\"][\"required\"] == [\"move\"]",
        "",
        "",
        "def test_unknown_method_and_parse_error(mcp) -> None:",
        "    resp = mcp.send(\"bogus/method\")",
        "    assert resp[\"error\"][\"code\"] == -32601",
        "    assert mcp.proc.stdin is not None and mcp.proc.stdout is not None",
        "    mcp.proc.stdin.write(\"this is not json\\n\")",
        "    mcp.proc.stdin.flush()",
        "    resp = json.loads(mcp.proc.stdout.readline())",
        "    assert resp[\"error\"][\"code\"] == -32700",
        "    assert resp[\"id\"] is None",
        "",
        "",
        "def test_unknown_tool_and_invalid_params_are_rpc_errors(mcp) -> None:",
        "    resp = mcp.send(\"tools/call\", {\"name\": \"nope\", \"arguments\": {}})",
        "    assert resp[\"error\"][\"code\"] == -32601",
        "    resp = mcp.send(\"tools/call\", {\"arguments\": {}})  # missing name",
        "    assert resp[\"error\"][\"code\"] == -32602",
        "    mcp.send(\"initialize\", {\"protocolVersion\": \"2024-11-05\"})",
        "    payload_result = mcp.call(\"new_game\")",
        "    assert \"content\" in payload_result",
        "    resp = mcp.send(\"tools/call\", {\"name\": \"ai_move\", \"arguments\": {\"depth\": 99}})",
        "    assert resp[\"error\"][\"code\"] == -32602",
        "",
        "",
        "def test_full_game_flow_over_mcp(mcp) -> None:",
        "    mcp.send(\"initialize\", {\"protocolVersion\": \"2024-11-05\"})",
        "    payload, err = mcp.payload(\"new_game\")",
        "    assert not err and payload[\"ok\"] and payload[\"status\"][\"version\"] >= 1",
        "    v0 = payload[\"status\"][\"version\"]",
        "",
        "    payload, err = mcp.payload(\"legal_moves\")",
        "    assert not err and len(payload[\"moves\"]) == 20",
        "",
        "    payload, err = mcp.payload(\"play_move\", {\"move\": \"e2e4\"})",
        "    assert not err and payload[\"move\"] == \"e2e4\" and payload[\"san\"] == \"e4\"",
        "    assert payload[\"status\"][\"turn\"] == \"b\"",
        "    assert payload[\"status\"][\"version\"] == v0 + 1",
        "",
        "    # SAN input works too",
        "    payload, err = mcp.payload(\"play_move\", {\"move\": \"e5\"})",
        "    assert not err and payload[\"move\"] == \"e7e5\" and payload[\"san\"] == \"e5\"",
        "",
        "    # illegal move -> isError:true + legal moves listed",
        "    payload, err = mcp.payload(\"play_move\", {\"move\": \"e2e5\"})",
        "    assert err and \"illegal move\" in payload[\"error\"] and len(payload[\"legal_moves\"]) == 29",
        "",
        "    payload, err = mcp.payload(\"analyze_position\", {\"depth\": 1})",
        "    assert not err and payload[\"best_move\"] in mcp.payload(\"legal_moves\")[0][\"moves\"]",
        "    assert isinstance(payload[\"score\"], int) and \"nodes\" in payload",
        "    # analyze must NOT change the position",
        "    fen_before = mcp.payload(\"get_status\")[0][\"fen\"]",
        "    mcp.payload(\"analyze_position\", {\"depth\": 1})",
        "    assert mcp.payload(\"get_status\")[0][\"fen\"] == fen_before",
        "",
        "    payload, err = mcp.payload(\"ai_move\", {\"depth\": 1})",
        "    assert not err and payload[\"ok\"] and payload[\"status\"][\"turn\"] == \"w\"",
        "",
        "    payload, err = mcp.payload(\"get_board\")",
        "    assert not err and \"R N B Q K\" in payload[\"ascii\"] and payload[\"turn\"] == \"w\"",
        "",
        "    payload, err = mcp.payload(\"get_pgn\")",
        "    assert not err and \"1. e4 e5\" in payload[\"pgn\"]",
        "",
        "    status, _ = mcp.payload(\"get_status\")",
        "    assert status[\"last_move\"] is not None and status[\"version\"] > v0",
        "",
        "",
        "def test_ai_move_on_finished_game_is_an_error(mcp) -> None:",
        "    mcp.payload(\"new_game\")",
        "    for mv in [\"f2f3\", \"e7e5\", \"g2g4\", \"d8h4\"]:  # fool's mate",
        "        payload, err = mcp.payload(\"play_move\", {\"move\": mv})",
        "        assert not err",
        "    payload, err = mcp.payload(\"ai_move\", {\"depth\": 1})",
        "    assert err and \"game is over\" in payload[\"error\"]",
        "    payload, err = mcp.payload(\"play_move\", {\"move\": \"a7a6\"})",
        "    assert err and \"game is over\" in payload[\"error\"]",
        "    status, _ = mcp.payload(\"get_status\")",
        "    assert status[\"result\"] == \"checkmate\" and status[\"winner\"] == \"b\"",
        ""
      ]
    }
  }
}
