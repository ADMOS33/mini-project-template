      "content": [
        "// Réglages (V11) : thèmes de plateau, mode clair/sombre, jeu de pièces, son ;",
        "// onglet « Parties » (archive) ; éditeur de position.",
        "// Le JS ne construit qu'une FEN à partir de l'état de l'éditeur — la validation",
        "// (position légale ou non) est faite par le moteur via /api/load.",
        "",
        "import { ChessAPI } from \"./api.js\";",
        "import { render, renderAll } from \"./board-view.js\";",
        "import { FILES, ls, lsSet, squareName, state, UNICODE_GLYPH, wireChips } from \"./state.js\";",
        "import { reportError, toast } from \"./toasts.js\";",
        "",
        "// --- Thèmes / apparence / pièces ---------------------------------------------------",
        "",
        "export function applyAppearance() {",
        "  try {",
        "    document.documentElement.dataset.theme = state.theme;",
        "    document.documentElement.dataset.mode = state.appearance;",
        "  } catch { /* dataset indisponible : on ignore */ }",
        "}",
        "",
        "export function initSettings() {",
        "  applyAppearance();",
        "  wireChips(\"opt-theme\", (v) => {",
        "    state.theme = v;",
        "    lsSet(\"chess.theme\", v);",
        "    applyAppearance();",
        "  }, state.theme);",
        "  wireChips(\"opt-mode\", (v) => {",
        "    state.appearance = v;",
        "    lsSet(\"chess.appearance\", v);",
        "    applyAppearance();",
        "  }, state.appearance);",
        "  wireChips(\"opt-pieces\", (v) => {",
        "    state.pieceSet = v;",
        "    lsSet(\"chess.pieces\", v);",
        "    render();",
        "  }, state.pieceSet);",
        "  document.getElementById(\"btn-settings\").addEventListener(\"click\", () => {",
        "    document.getElementById(\"settings-modal\").classList.remove(\"hidden\");",
        "  });",
        "  document.getElementById(\"btn-close-settings\").addEventListener(\"click\", () => {",
        "    document.getElementById(\"settings-modal\").classList.add(\"hidden\");",
        "  });",
        "  initEditor();",
        "  document.getElementById(\"btn-games-refresh\").addEventListener(\"click\", renderGames);",
        "}",
        "",
        "// --- Onglet « Parties » : archive (V11) ----------------------------------------------",
        "",
        "export async function renderGames() {",
        "  const body = document.getElementById(\"games-body\");",
        "  const stats = document.getElementById(\"games-stats\");",
        "  try {",
        "    const data = await ChessAPI._req(\"/api/games\");",
        "    const games = data.games || [];",
        "    body.innerHTML = \"\";",
        "    if (!games.length) {",
        "      body.innerHTML = '<tr class=\"empty-row\"><td colspan=\"4\">Aucune partie archivée</td></tr>';",
        "    }",
        "    for (const g of games) {",
        "      const tr = document.createElement(\"tr\");",
        "      tr.className = \"game-row\";",
        "      const result = g.result === \"ongoing\" ? \"en cours\" : g.winner === \"w\" ? \"1-0\" : g.winner === \"b\" ? \"0-1\" : \"nulle\";",
        "      tr.innerHTML = \"\";",
        "      for (const txt of [`#${g.id}`, (g.date || \"\").slice(0, 10), `${result} (${g.result})`, `${g.moves_count}`]) {",
        "        const td = document.createElement(\"td\");",
        "        td.textContent = txt;",
        "        tr.appendChild(td);",
        "      }",
        "      tr.title = `${g.mode || \"?\"}${g.level ? \" · \" + g.level : \"\"}${g.opening ? \" · \" + g.opening.code + \" \" + g.opening.name : \"\"}`;",
        "      tr.addEventListener(\"click\", async () => {",
        "        try {",
        "          const full = await ChessAPI._req(`/api/games/${g.id}`);",
        "          await ChessAPI.loadPgn(full.pgn);",
        "          state.reviewPly = null;",
        "          state.puzzle = null;",
        "          state.analysis = null;",
        "          await renderAll();",
        "          document.getElementById(\"tab-partie\").click();",
        "          toast(`Partie #${g.id} rechargée — PGN importé.`, \"info\");",
        "        } catch (err) {",
        "          reportError(\"Archive\", err);",
        "        }",
        "      });",
        "      body.appendChild(tr);",
        "    }",
        "    // statistiques simples : taux de victoire par niveau (mode ordinateur)",
        "    const byLevel = {};",
        "    for (const g of games) {",
        "      if (g.mode !== \"computer\" || !g.level) continue;",
        "      byLevel[g.level] = byLevel[g.level] || { total: 0, wins: 0 };",
        "      byLevel[g.level].total += 1;",
        "      if (g.winner && g.winner === playerColorGuess()) byLevel[g.level].wins += 1;",
        "    }",
        "    const parts = Object.entries(byLevel).map(",
        "      ([lv, s]) => `${lv}: ${s.wins}/${s.total} gagnées`",
        "    );",
        "    stats.textContent = parts.length",
        "      ? `Victoires par niveau — ${parts.join(\" · \")}`",
        "      : `${games.length} partie(s) archivée(s).`;",
        "  } catch (err) {",
        "    if (err instanceof TypeError) return; // API down: géré par l'overlay global",
        "    reportError(\"Archive\", err);",
        "  }",
        "}",
        "",
        "function playerColorGuess() {",
        "  // en mode ordinateur la couleur du joueur est stockée côté UI ; à défaut on",
        "  // compte les victoires du camp qui a commencé (indicatif seulement)",
        "  return state.vs ? (state.colorChoice === \"random\" ? state.actualColor : state.colorChoice) : \"w\";",
        "}",
        "",
        "// --- Éditeur de position (V11) ---------------------------------------------------------",
        "",
        "const PALETTE = [\"K\", \"Q\", \"R\", \"B\", \"N\", \"P\", \"k\", \"q\", \"r\", \"b\", \"n\", \"p\"];",
        "let editorSquares = {}; // \"e4\" -> \"P\"",
        "let editorSelected = \"P\";",
        "let editorTurn = \"w\";",
        "let editorCastling = new Set([\"K\", \"Q\", \"k\", \"q\"]);",
        "",
        "function editorReset() {",
        "  editorSquares = {};",
        "  const start = {",
        "    a8: \"r\", b8: \"n\", c8: \"b\", d8: \"q\", e8: \"k\", f8: \"b\", g8: \"n\", h8: \"r\",",
        "    a7: \"p\", b7: \"p\", c7: \"p\", d7: \"p\", e7: \"p\", f7: \"p\", g7: \"p\", h7: \"p\",",
        "    a2: \"P\", b2: \"P\", c2: \"P\", d2: \"P\", e2: \"P\", f2: \"P\", g2: \"P\", h2: \"P\",",
        "    a1: \"R\", b1: \"N\", c1: \"B\", d1: \"Q\", e1: \"K\", f1: \"B\", g1: \"N\", h1: \"R\",",
        "  };",
        "  Object.assign(editorSquares, start);",
        "  editorTurn = \"w\";",
        "  editorCastling = new Set([\"K\", \"Q\", \"k\", \"q\"]);",
        "}",
        "",
        "function renderEditorBoard() {",
        "  const board = document.getElementById(\"editor-board\");",
        "  board.innerHTML = \"\";",
        "  for (let r = 7; r >= 0; r--) {",
        "    for (let f = 0; f < 8; f++) {",
        "      const name = squareName(f, r);",
        "      const sq = document.createElement(\"div\");",
        "      sq.className = \"square \" + ((f + r) % 2 === 0 ? \"dark\" : \"light\");",
        "      sq.dataset.square = name;",
        "      const sym = editorSquares[name];",
        "      if (sym) {",
        "        const span = document.createElement(\"span\");",
        "        span.className = \"piece editor-piece\";",
        "        span.textContent = UNICODE_GLYPH[sym] || sym;",
        "        span.draggable = true;",
        "        span.addEventListener(\"dragstart\", (e) => {",
        "          e.dataTransfer.setData(\"text/plain\", name);",
        "        });",
        "        sq.appendChild(span);",
        "      }",
        "      sq.addEventListener(\"click\", () => {",
        "        if (editorSelected === \"erase\") delete editorSquares[name];",
        "        else editorSquares[name] = editorSelected;",
        "        renderEditorBoard();",
        "      });",
        "      sq.addEventListener(\"dragover\", (e) => e.preventDefault());",
        "      sq.addEventListener(\"drop\", (e) => {",
        "        e.preventDefault();",
        "        const from = e.dataTransfer.getData(\"text/plain\");",
        "        if (from && from !== name) {",
        "          editorSquares[name] = editorSquares[from];",
        "          delete editorSquares[from];",
        "        } else if (from === name) {",
        "          // déposé depuis la palette : dataTransfer vide -> on prend la sélection",
        "          editorSquares[name] = editorSelected;",
        "        }",
        "        renderEditorBoard();",
        "      });",
        "      board.appendChild(sq);",
        "    }",
        "  }",
        "}",
        "",
        "function editorFen() {",
        "  // Sérialise l'état de l'éditeur en FEN — aucune règle ici, le moteur valide.",
        "  const rows = [];",
        "  for (let r = 7; r >= 0; r--) {",
        "    let row = \"\";",
        "    let empty = 0;",
        "    for (let f = 0; f < 8; f++) {",
        "      const sym = editorSquares[squareName(f, r)];",
        "      if (!sym) empty += 1;",
        "      else {",
        "        if (empty) { row += String(empty); empty = 0; }",
        "        row += sym;",
        "      }",
        "    }",
        "    if (empty) row += String(empty);",
        "    rows.push(row || \"8\");",
        "  }",
        "  const castling = [\"K\", \"Q\", \"k\", \"q\"].filter((c) => editorCastling.has(c)).join(\"\") || \"-\";",
        "  return `${rows.join(\"/\")} ${editorTurn} ${castling} - 0 1`;",
        "}",
        "",
        "function initEditor() {",
        "  const palette = document.getElementById(\"editor-palette\");",
        "  for (const sym of [...PALETTE, \"erase\"]) {",
        "    const b = document.createElement(\"button\");",
        "    b.type = \"button\";",
        "    b.className = \"chip editor-palette-item\";",
        "    b.textContent = sym === \"erase\" ? \"🧽\" : UNICODE_GLYPH[sym];",
        "    b.draggable = sym !== \"erase\";",
        "    b.addEventListener(\"dragstart\", (e) => {",
        "      e.dataTransfer.setData(\"text/plain\", \"\");",
        "      editorSelected = sym;",
        "    });",
        "    b.addEventListener(\"click\", () => {",
        "      editorSelected = sym;",
        "      palette.querySelectorAll(\".editor-palette-item\").forEach((x) =>",
        "        x.setAttribute(\"aria-pressed\", String(x === b))",
        "      );",
        "    });",
        "    palette.appendChild(b);",
        "  }",
        "  wireChips(\"editor-turn\", (v) => { editorTurn = v; }, \"w\");",
        "  document.querySelectorAll(\"#editor-castling .chip\").forEach((chip) => {",
        "    chip.addEventListener(\"click\", () => {",
        "      const v = chip.dataset.value;",
        "      if (editorCastling.has(v)) editorCastling.delete(v);",
        "      else editorCastling.add(v);",
        "      chip.setAttribute(\"aria-pressed\", String(editorCastling.has(v)));",
        "    });",
        "  });",
        "  document.getElementById(\"btn-editor\").addEventListener(\"click\", () => {",
        "    editorReset();",
        "    renderEditorBoard();",
        "    document.getElementById(\"editor-modal\").classList.remove(\"hidden\");",
        "  });",
        "  document.getElementById(\"btn-close-editor\").addEventListener(\"click\", () => {",
        "    document.getElementById(\"editor-modal\").classList.add(\"hidden\");",
        "  });",
        "  document.getElementById(\"btn-editor-reset\").addEventListener(\"click\", () => {",
        "    editorReset();",
        "    renderEditorBoard();",
        "  });",
        "  document.getElementById(\"btn-editor-clear\").addEventListener(\"click\", () => {",
        "    editorSquares = {};",
        "    renderEditorBoard();",
        "  });",
        "  document.getElementById(\"btn-editor-start\").addEventListener(\"click\", async () => {",
        "    const fen = editorFen();",
        "    try {",
        "      await ChessAPI.load(fen); // validation par le moteur",
        "      document.getElementById(\"editor-modal\").classList.add(\"hidden\");",
        "      state.puzzle = null;",
        "      state.analysis = null;",
        "      state.reviewPly = null;",
        "      await renderAll();",
        "      toast(\"Position chargée (validée par le moteur).\", \"info\");",
        "    } catch (err) {",
        "      reportError(\"Position invalide\", err); // toast uniquement",
        "    }",
        "  });",
        "}",
        ""
      ]
    },
    "tool_status": "success",
