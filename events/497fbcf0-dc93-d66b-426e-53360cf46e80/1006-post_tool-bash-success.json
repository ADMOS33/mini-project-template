        "def _ep_capture_playable(board: Board) -> bool:",
        "    \"\"\"True if a pawn of the side to move can actually capture en passant.\"\"\"",
        "    if board.ep_square is None:",
        "        return False",
        "    f, r = square_file(board.ep_square), square_rank(board.ep_square)",
        "    forward = 1 if board.turn is Color.WHITE else -1",
        "    pawn_rank = r - forward",
        "    if not 0 <= pawn_rank < 8:",
        "        return False",
        "    pawn = Piece(PieceType.PAWN, board.turn)",
        "    for df in (-1, 1):",
        "        pf = f + df",
        "        if 0 <= pf < 8 and board.squares[square(pf, pawn_rank)] == pawn:",
        "            return True",
        "    return False",
        "",
        "",
        "def best_move(board: Board, depth: int = 3) -> tuple[Move, int, int]:",
        "    \"\"\"``(best move, score for the side to move, nodes visited)`` at ``depth``.\"\"\"",
        "    if depth < 1:",
        "        raise ValueError(f\"depth must be >= 1, got {depth}\")",
        "    best: Move | None = None",
        "    best_score = -_INF",
        "    alpha = -_INF",
        "    nodes = 0",
        "    for move in _ordered_moves(board):",
        "        child_score, child_nodes = negamax(apply_move(board, move), depth - 1, -_INF, -alpha)",
        "        nodes += 1 + child_nodes",
        "        score = -child_score  # negamax: child score is from the opponent's view",
        "        if score > best_score:",
        "            best_score = score",
        "            best = move",
        "        if score > alpha:",
        "            alpha = score",
        "    if best is None:",
        "        raise ValueError(\"no legal move available\")",
        "    return best, best_score, nodes",
