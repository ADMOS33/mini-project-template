    "tool_output": {
      "content": [
        "\"\"\"SAN (Standard Algebraic Notation): rendering and parsing.",
        "",
        "``move_to_san(board, move)`` renders a legal move in SAN (``Nf3``, ``exd5``,",
        "``Nbd2``, ``R1e2``, ``Qh4e1``, ``e8=Q``, ``exd8=N``, ``O-O``, with ``+``/``#``",
        "suffixes). ``san_to_move(board, san)`` parses SAN back to a :class:`Move`,",
        "tolerating trailing ``+``, ``#``, ``!``, ``?`` and the ``0-0`` spelling of",
        "castling.",
        "\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "import re",
        "",
        "from chess.engine.board import FILES, RANKS, Board, parse_square, square_file, square_name, square_rank",
        "from chess.engine.move import Move",
        "from chess.engine.movegen import apply_move, is_square_attacked, legal_moves",
        "from chess.engine.pieces import PieceType",
        "",
        "_PIECE_LETTERS = {",
        "    PieceType.KNIGHT: \"N\",",
        "    PieceType.BISHOP: \"B\",",
        "    PieceType.ROOK: \"R\",",
        "    PieceType.QUEEN: \"Q\",",
        "    PieceType.KING: \"K\",",
        "}",
        "",
        "_MOVE_RE = re.compile(",
        "    r\"^(?P<piece>[KQRBN])?\"",
        "    r\"(?P<from_file>[a-h])?\"",
        "    r\"(?P<from_rank>[1-8])?\"",
        "    r\"(?P<capture>x)?\"",
        "    r\"(?P<to>[a-h][1-8])\"",
        "    r\"(?:=(?P<promo>[QRBNqrbn]))?$\"",
        ")",
        "",
        "",
        "def _is_capture(board: Board, move: Move, piece_type: PieceType) -> bool:",
        "    if board.piece_at(move.to_sq) is not None:",
        "        return True",
        "    # En passant: the destination is empty but the ep square is the target.",
        "    return (",
        "        piece_type is PieceType.PAWN",
        "        and move.to_sq == board.ep_square",
        "        and square_file(move.to_sq) != square_file(move.from_sq)",
        "    )",
        "",
        "",
        "def move_to_san(board: Board, move: Move) -> str:",
        "    \"\"\"SAN of ``move`` in position ``board`` (e.g. ``Nf3``, ``exd5``, ``O-O``).\"\"\"",
        "    piece = board.piece_at(move.from_sq)",
        "    if piece is None:",
        "        raise ValueError(\"no piece on the origin square\")",
        "    is_capture = _is_capture(board, move, piece.type)",
        "    if piece.type is PieceType.KING and abs(move.to_sq - move.from_sq) == 2:",
        "        san = \"O-O\" if square_file(move.to_sq) == 6 else \"O-O-O\"",
        "    elif piece.type is PieceType.PAWN:",
        "        san = \"\"",
        "        if is_capture:",
        "            san += FILES[square_file(move.from_sq)] + \"x\"",
        "        san += square_name(move.to_sq)",
        "        if move.promotion is not None:",
        "            san += \"=\" + move.promotion.value.upper()",
        "    else:",
        "        san = _PIECE_LETTERS[piece.type]",
        "        others = [",
        "            m",
        "            for m in legal_moves(board)",
        "            if m.to_sq == move.to_sq",
        "            and m.from_sq != move.from_sq",
        "            and (p := board.piece_at(m.from_sq)) is not None",
        "            and p.type is piece.type",
        "        ]",
        "        if others:",
        "            same_file = any(square_file(m.from_sq) == square_file(move.from_sq) for m in others)",
        "            same_rank = any(square_rank(m.from_sq) == square_rank(move.from_sq) for m in others)",
        "            if not same_file:",
        "                san += FILES[square_file(move.from_sq)]",
        "            elif not same_rank:",
        "                san += RANKS[square_rank(move.from_sq)]",
        "            else:",
        "                san += square_name(move.from_sq)",
        "        if is_capture:",
        "            san += \"x\"",
        "        san += square_name(move.to_sq)",
        "    new = apply_move(board, move)",
        "    if is_square_attacked(new, new.king_square(new.turn), board.turn):",
        "        san += \"#\" if not legal_moves(new) else \"+\"",
        "    return san",
        "",
        "",
        "def san_to_move(board: Board, san: str) -> Move:",
        "    \"\"\"Parse a SAN string into a legal :class:`Move` of ``board``.",
        "",
        "    Raises ValueError on unknown, illegal or ambiguous SAN. Trailing",
        "    ``+``/``#``/``!``/``?`` annotations are ignored; castling accepts",
        "    ``O-O``/``O-O-O`` and the ``0-0``/``0-0-0`` spellings.",
        "    \"\"\"",
        "    text = san.strip().rstrip(\"+#?!\")",
        "    if not text:",
        "        raise ValueError(f\"unknown SAN move: {san!r}\")",
        "    normalized = text.lower().replace(\"0\", \"o\")",
        "    if normalized in (\"o-o\", \"o-o-o\"):",
        "        want_file = 6 if normalized == \"o-o\" else 2",
        "        for move in legal_moves(board):",
        "            piece = board.piece_at(move.from_sq)",
        "            if (",
        "                piece is not None",
        "                and piece.type is PieceType.KING",
        "                and abs(move.to_sq - move.from_sq) == 2",
        "                and square_file(move.to_sq) == want_file",
        "            ):",
        "                return move",
        "        raise ValueError(f\"illegal castling move: {san!r}\")",
        "    match = _MOVE_RE.match(text)",
        "    if match is None:",
        "        raise ValueError(f\"unknown SAN move: {san!r}\")",
        "    piece_letter = match.group(\"piece\")",
        "    piece_type = PieceType(piece_letter.lower()) if piece_letter else PieceType.PAWN",
        "    to_sq = parse_square(match.group(\"to\"))",
        "    from_file = FILES.index(match.group(\"from_file\")) if match.group(\"from_file\") else None",
        "    from_rank = RANKS.index(match.group(\"from_rank\")) if match.group(\"from_rank\") else None",
        "    promo = match.group(\"promo\")",
        "    promotion = PieceType(promo.lower()) if promo else None",
        "    candidates = [",
        "        move",
        "        for move in legal_moves(board)",
        "        if (p := board.piece_at(move.from_sq)) is not None",
        "        and p.type is piece_type",
        "        and move.to_sq == to_sq",
        "        and (from_file is None or square_file(move.from_sq) == from_file)",
        "        and (from_rank is None or square_rank(move.from_sq) == from_rank)",
        "        and move.promotion == promotion",
        "    ]",
        "    if not candidates:",
        "        raise ValueError(f\"illegal SAN move: {san!r}\")",
        "    if len(candidates) > 1:",
        "        raise ValueError(f\"ambiguous SAN move: {san!r}\")",
        "    return candidates[0]",
        ""
      ],
