        "from chess.engine.pieces import Color",
        "from collections import Counter",
        "",
        "# sanity: known mate-in-1 position",
        "b = board_from_fen(\"7k/8/5QK1/8/8/8/8/8 w - - 0 1\")",
        "print(\"mate-in-1 sanity:\", [m.to_uci() for m in find_mates(b, 1)], [m.to_uci() for m in find_mates(b, 2)])",
        "",
        "rng = random.Random(7)",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "def build(strong, extras, weak):",
        "    sqs = [None]*64",
        "    kb = rng.choice(EDGE)",
        "    cands = [s for s in range(64) if max(abs(s%8-kb%8), abs(s//8-kb//8)) == 2]",
        "    ks = rng.choice(cands)",
        "    sqs[kb] = \"k\" if strong==\"w\" else \"K\"; sqs[ks] = \"K\" if strong==\"w\" else \"k\"",
        "    for letter in extras:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter if strong==\"w\" else letter.lower()",
        "    for letter in weak:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter.lower() if strong==\"w\" else letter.upper()",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    try: b=board_from_fen(\"/\".join(rows)+f\" {strong} - - 0 1\")",
        "    except ValueError: return None",
        "    wc = Color.BLACK if strong==\"w\" else Color.WHITE",
        "    if is_square_attacked(b, b.king_square(wc), Color.WHITE if strong==\"w\" else Color.BLACK): return None",
        "    return b",
        "",
        "dist = Counter(); exact = 0; t0=time.time(); tries=0",
        "while time.time()-t0 < 45:",
        "    tries += 1",
        "    b = build(\"w\", rng.choice([[\"Q\",\"R\"],[\"Q\"],[\"R\",\"R\"],[\"Q\",\"B\"],[\"Q\",\"N\"]]), rng.choice([[],[\"p\"],[\"r\"],[\"n\"]]))",
        "    if b is None: continue",
        "    ms = find_mates(b, 2)",
        "    dist[len(ms)] += 1",
        "    if len(ms)==1 and not is_checkmate(apply_move(b, ms[0])): exact += 1",
        "print(\"tries\", tries, \"dist\", dict(dist), \"exact\", exact, f\"{time.time()-t0:.0f}s\")",
        "EOF"
      ]
