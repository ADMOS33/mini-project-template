        "\"\"\"Tests for the AI (chess/ai/evaluation.py and chess/ai/search.py).\"\"\"",
        "",
        "import pytest",
        "",
        "from chess.ai.evaluation import evaluate",
        "from chess.ai.search import MATE_SCORE, best_move, negamax",
