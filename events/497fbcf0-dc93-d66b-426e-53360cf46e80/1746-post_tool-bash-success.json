        "",
        "CORNERS=[0,7,56,63]",
        "t0=time.time(); total=0; aprop=0; ex=None",
        "for kb in CORNERS:",
        "    kf,kr=kb%8,kb//8",
        "    for ks in range(64):",
        "        if max(abs(ks%8-kf),abs(ks//8-kr))!=2: continue",
        "        for qs in range(64):",
        "            if qs in (kb,ks): continue",
        "            sqs=[None]*64; sqs[kb]=\"k\"; sqs[ks]=\"K\"; sqs[qs]=\"Q\"",
        "            try: A=make(sqs,\"b\")",
        "            except ValueError: continue",
        "            if is_square_attacked(A, A.king_square(Color.WHITE), Color.BLACK): continue",
        "            total += 1",
        "            if all_replies_mated_in(A, 1):",
        "                aprop += 1",
        "                if ex is None: ex = make(sqs,\"b\")",
        "    if time.time()-t0 > 40: break",
        "print(f\"total={total} A-prop={aprop} in {time.time()-t0:.0f}s\")",
        "if ex is not None:",
        "    from chess.engine.fen import board_to_fen",
        "    print(\"example A:\", board_to_fen(ex))",
        "EOF"
