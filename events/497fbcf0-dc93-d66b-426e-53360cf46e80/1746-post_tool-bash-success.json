        "",
        "def make(sqs, turn):",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows)+f\" {turn} - - 0 1\")",
        "",
        "def all_replies_mated_in(A, n):",
