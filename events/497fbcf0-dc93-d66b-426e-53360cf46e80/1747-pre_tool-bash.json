      "command": [
        "cd /Users/rafiq/3A/projet-AI/mini-project-template && .venv/bin/python - <<'EOF'",
        "import sys, time",
        "sys.path.insert(0, \".\")",
        "from chess.ai.mate import find_mates",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import apply_move, legal_moves, is_square_attacked",
        "from chess.engine.board import square, square_file, square_rank",
        "from chess.engine.pieces import Color, PieceType",
        "",
        "def make(sqs, turn):",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows)+f\" {turn} - - 0 1\")",
        "",
        "def all_replies_mated_in(A, n):",
        "    replies = legal_moves(A)",
        "    if not replies: return False",
        "    return all(find_mates(apply_move(A, r), n) for r in replies)",
        "",
        "def reverse_moves(A):",
        "    out=[]",
        "    for sq,p in enumerate(A.squares):",
        "        if p is None or p.color is not Color.WHITE or p.type is PieceType.PAWN: continue",
        "        f,r = square_file(sq), square_rank(sq)",
        "        cands=[]",
        "        if p.type is PieceType.KING:",
        "            for df in (-1,0,1):",
        "                for dr in (-1,0,1):",
        "                    if df or dr: cands.append((f+df,r+dr))",
        "        elif p.type is PieceType.QUEEN or p.type is PieceType.ROOK:",
        "            dirs=[(1,0),(-1,0),(0,1),(0,-1)]",
        "            if p.type is PieceType.QUEEN: dirs += [(1,1),(1,-1),(-1,1),(-1,-1)]",
        "            for df,dr in dirs:",
        "                nf,nr=f+df,r+dr",
        "                while 0<=nf<8 and 0<=nr<8:",
        "                    cands.append((nf,nr))",
        "                    if A.squares[square(nf,nr)] is not None: break",
        "                    nf+=df; nr+=dr",
        "        for nf,nr in cands:",
        "            if not(0<=nf<8 and 0<=nr<8): continue",
        "            tsq=square(nf,nr)",
        "            if A.squares[tsq] is not None: continue",
        "            sqs=list(A.squares); sqs[tsq]=p; sqs[sq]=None",
        "            try: L=make(sqs,\"w\")",
        "            except ValueError: continue",
        "            if is_square_attacked(L, L.king_square(Color.BLACK), Color.WHITE): continue",
        "            out.append(L)",
        "    return out",
        "",
        "CORNERS=[0,7,56,63]",
        "t0=time.time(); total=0; aprop=0; lhit=0; ex=[]",
        "for kb in CORNERS:",
        "    kf,kr=kb%8,kb//8",
        "    for ks in range(64):",
        "        if max(abs(ks%8-kf),abs(ks//8-kr))!=2: continue",
        "        for qs in range(64):",
        "            if qs in (kb,ks): continue",
        "            if time.time()-t0>40: break",
        "            sqs=[None]*64; sqs[kb]=\"k\"; sqs[ks]=\"K\"; sqs[qs]=\"Q\"",
        "            try: A=make(sqs,\"b\")",
        "            except ValueError: continue",
        "            if is_square_attacked(A, A.king_square(Color.WHITE), Color.BLACK): continue",
        "            total+=1",
        "            if not all_replies_mated_in(A,1): continue",
        "            aprop+=1",
        "            for L in reverse_moves(A):",
        "                if find_mates(L,1): continue",
        "                ms=find_mates(L,2)",
        "                if len(ms)==1:",
        "                    lhit+=1",
        "                    if len(ex)<5: ex.append((board_to_fen(L), ms[0].to_uci()))",
        "    if time.time()-t0>40: break",
        "print(f\"total={total} aprop={aprop} exact-l2={lhit} in {time.time()-t0:.0f}s\")",
        "for e in ex: print(e)",
        "EOF"
      ]
    }
  }
