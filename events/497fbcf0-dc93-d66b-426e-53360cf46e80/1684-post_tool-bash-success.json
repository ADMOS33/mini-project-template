        "\"\"\"Constructive exact mate-in-n generation.",
        "",
        "For n=2: find positions A (black to move) where EVERY black reply allows a",
        "mate in 1 for white; then step one white move back to get a white-to-move",
        "position L and keep it if find_mates(L,2) has exactly one move and L has no",
        "mate in 1 (exact mate in 2).",
        "For n=3: same idea one level deeper (every black reply allows mate in <=2).",
        "\"\"\"",
        "import json, os, random, sys, time, traceback",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.mate import find_mates, is_checkmate",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import apply_move, is_square_attacked, legal_moves",
        "from chess.engine.board import Board, square, square_file, square_rank",
        "from chess.engine.pieces import Color, Piece, PieceType",
        "",
        "rng = random.Random(31337)",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "OUT = \"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\"",
        "DEADLINE = time.time() + 22 * 60",
        "THEME = {\"Q\": \"Mat a la dame\", \"R\": \"Mat a la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aide\"}",
        "",
        "def board_with(sqs, turn):",
        "    rows = []",
        "    for r in range(7, -1, -1):",
        "        row, e = \"\", 0",
        "        for f in range(8):",
        "            p = sqs[r * 8 + f]",
        "            if p is None: e += 1",
        "            else:",
        "                if e: row += str(e); e = 0",
        "                row += p",
        "        if e: row += str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows) + f\" {turn} - - 0 1\")",
        "",
        "def random_A(strong_sets):",
        "    \"\"\"Position with the WEAK side to move; weak king on the edge.\"\"\"",
        "    sqs = [None] * 64",
        "    strong = rng.choice([\"w\", \"b\"])",
        "    weak = \"b\" if strong == \"w\" else \"w\"",
        "    kb = rng.choice(EDGE)",
        "    cands = [s for s in range(64) if max(abs(s % 8 - kb % 8), abs(s // 8 - kb // 8)) == 2]",
        "    ks = rng.choice(cands)",
        "    sqs[kb] = \"k\" if weak == \"b\" else \"K\"",
        "    sqs[ks] = \"K\" if weak == \"b\" else \"k\"",
        "    for letter in rng.choice(strong_sets):",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None, None",
        "        sqs[s] = letter if strong == \"w\" else letter.lower()",
        "    if rng.random() < 0.5:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is None:",
        "            sqs[s] = \"p\" if weak == \"b\" else \"P\"",
        "    try:",
        "        b = board_with(sqs, weak)",
        "    except ValueError:",
        "        return None, None",
        "    # the side NOT to move (strong) must not be in check",
        "    sc = Color.WHITE if strong == \"w\" else Color.BLACK",
        "    wc = Color.BLACK if strong == \"w\" else Color.WHITE",
        "    if is_square_attacked(b, b.king_square(sc), wc):",
        "        return None, None",
        "    return b, strong",
        "",
        "def all_replies_mated_in(A, n):",
        "    \"\"\"A: weak side to move. True if A has >=1 legal move and every legal",
        "    reply leaves a position where the strong side can mate in <= n.\"\"\"",
        "    replies = legal_moves(A)",
        "    if not replies:",
        "        return False",
        "    for r in replies:",
        "        child = apply_move(A, r)",
        "        if not find_mates(child, n):",
        "            return False",
        "    return True",
        "",
        "def reverse_white_moves(A, strong):",
        "    \"\"\"All positions obtained by moving one strong-side piece one step back.\"\"\"",
        "    out = []",
        "    sc = Color.WHITE if strong == \"w\" else Color.BLACK",
        "    for sq, p in enumerate(A.squares):",
        "        if p is None or p.color is not sc or p.type is PieceType.PAWN:",
        "            continue",
        "        f, r = square_file(sq), square_rank(sq)",
        "        cands = []",
        "        if p.type is PieceType.KING:",
        "            for df in (-1, 0, 1):",
        "                for dr in (-1, 0, 1):",
        "                    if df or dr: cands.append((f + df, r + dr))",
        "        elif p.type is PieceType.KNIGHT:",
        "            for df, dr in ((1,2),(2,1),(2,-1),(1,-2),(-1,-2),(-2,-1),(-2,1),(-1,2)):",
        "                cands.append((f + df, r + dr))",
        "        else:",
        "            dirs = []",
        "            if p.type in (PieceType.ROOK, PieceType.QUEEN): dirs += [(1,0),(-1,0),(0,1),(0,-1)]",
        "            if p.type in (PieceType.BISHOP, PieceType.QUEEN): dirs += [(1,1),(1,-1),(-1,1),(-1,-1)]",
        "            for df, dr in dirs:",
        "                nf, nr = f + df, r + dr",
        "                while 0 <= nf < 8 and 0 <= nr < 8:",
        "                    cands.append((nf, nr))",
        "                    if A.squares[square(nf, nr)] is not None: break",
        "                    nf += df; nr += dr",
        "        for nf, nr in cands:",
        "            if not (0 <= nf < 8 and 0 <= nr < 8): continue",
        "            tsq = square(nf, nr)",
        "            if A.squares[tsq] is not None: continue",
        "            sqs = list(A.squares)",
        "            sqs[tsq] = p",
        "            sqs[sq] = None",
        "            try:",
        "                L = Board(list(sqs), A.turn, set(A.castling), None, 0, A.fullmove_number)",
        "                # side to move must become the strong side; validate",
        "                from chess.engine.fen import board_to_fen as b2f",
        "                fen = b2f(L)",
        "                parts = fen.split()",
        "                parts[1] = \"w\" if strong == \"w\" else \"b\"",
        "                L = board_from_fen(\" \".join(parts))",
        "            except ValueError:",
        "                continue",
        "            # strong side to move; weak king may not be attacked",
        "            wc = Color.BLACK if strong == \"w\" else Color.WHITE",
        "            if is_square_attacked(L, L.king_square(wc), sc):",
        "                continue",
        "            out.append(L)",
        "    return out",
        "",
        "def save(puzzles):",
        "    json.dump(puzzles, open(OUT, \"w\"), indent=2, ensure_ascii=False)",
        "",
        "all_found = []",
        "if os.path.exists(OUT):",
        "    all_found = [p for p in json.load(open(OUT)) if p[\"level\"] == 1]",
        "    save(all_found)",
        "print(f\"resume with {len(all_found)} l1\", flush=True)",
        "",
        "def collect(n, wanted, strong_sets, max_rounds):",
        "    have = sum(1 for q in all_found if q[\"level\"] == n)",
        "    found = []",
        "    rounds = 0",
        "    t0 = time.time()",
        "    while have + len(found) < wanted and rounds < max_rounds and time.time() < DEADLINE:",
        "        rounds += 1",
        "        try:",
        "            A, strong = random_A(strong_sets)",
        "            if A is None:",
        "                continue",
        "            # A: weak to move; every weak reply must allow mate in <= n-1... no:",
        "            # for puzzle depth n we need: after the solver's first move, every",
        "            # opponent reply allows mate in <= n-1. So A must satisfy",
        "            # all_replies_mated_in(A, n-1); L is one strong move before A.",
        "            if not all_replies_mated_in(A, n - 1):",
        "                continue",
        "            for L in reverse_white_moves(A, strong):",
        "                if find_mates(L, n - 1):",
        "                    continue  # would be a shorter mate: not exact",
        "                ms = find_mates(L, n)",
        "                if len(ms) == 1:",
        "                    p = L.piece_at(ms[0].from_sq)",
        "                    found.append({\"fen\": board_to_fen(L), \"solution\": ms[0].to_uci(),",
        "                                  \"level\": n,",
        "                                  \"theme\": THEME.get(p.symbol.upper() if p else \"?\", \"Mat force\")})",
        "                    print(f\"n={n} #{len(found)} (round {rounds}, {time.time()-t0:.0f}s): \"",
        "                          f\"{board_to_fen(L)} sol={ms[0].to_uci()}\", flush=True)",
        "                    save(all_found + found)",
        "                    break",
        "        except Exception:",
        "            traceback.print_exc()",
        "    return found",
        "",
        "try:",
        "    r = collect(2, 12, [[\"Q\", \"R\"], [\"Q\"], [\"R\", \"R\"], [\"Q\", \"B\"], [\"Q\", \"N\"], [\"R\", \"B\", \"B\"]], 4000)",
