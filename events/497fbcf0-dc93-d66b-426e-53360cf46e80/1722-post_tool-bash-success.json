        "import sys, itertools, time",
        "sys.path.insert(0, \".\")",
        "from chess.ai.mate import find_mates",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import is_square_attacked",
        "from chess.engine.pieces import Color",
        "",
        "def make(sqs, turn):",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows)+f\" {turn} - - 0 1\")",
        "",
        "CORNERS=[0,7,56,63]",
        "found=[]",
        "t0=time.time()",
        "for kb in CORNERS:",
        "    kf,kr=kb%8,kb//8",
        "    for ks in range(64):",
        "        if max(abs(ks%8-kf),abs(ks//8-kr))!=2: continue",
        "        for qs in range(64):",
        "            if qs in (kb,ks): continue",
        "            sqs=[None]*64; sqs[kb]=\"k\"; sqs[ks]=\"K\"; sqs[qs]=\"Q\"",
        "            try: L=make(sqs,\"w\")",
        "            except ValueError: continue",
        "            if is_square_attacked(L, L.king_square(Color.BLACK), Color.WHITE): continue",
        "            if find_mates(L,1): continue",
        "            ms=find_mates(L,2)",
        "            if len(ms)==1:",
        "                found.append((board_to_fen(L), ms[0].to_uci()))",
        "                print(board_to_fen(L), ms[0].to_uci(), flush=True)",
        "                if len(found)>=6: break",
        "        if len(found)>=6: break",
        "    if len(found)>=6: break",
        "print(\"elapsed\", time.time()-t0)",
        "EOF"
      ]
