      "content": [
        "\"\"\"Chess960 (V12): the 960 legal starting positions (SPN 0-959).",
        "",
        "Rules for a start position: bishops on opposite-colored squares, the king",
        "between the two rooks. SPN 518 is the standard chess position.",
        "\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from chess.engine.board import Board, square, square_file, square_rank",
        "from chess.engine.fen import board_to_fen",
        "from chess.engine.pieces import Color, Piece, PieceType",
        "",
        "_BACK_RANK = [PieceType.ROOK, PieceType.KNIGHT, PieceType.BISHOP, None,",
        "              None, PieceType.BISHOP, PieceType.KNIGHT, PieceType.ROOK]",
        "",
        "",
        "def _back_rank(king_file: int, queen_file: int, bishop_files: tuple[int, int]) -> list:",
        "    rank = list(_BACK_RANK)",
        "    rank[king_file] = PieceType.KING",
        "    rank[queen_file] = PieceType.QUEEN",
        "    rank[bishop_files[0]] = PieceType.BISHOP",
        "    rank[bishop_files[1]] = PieceType.BISHOP",
        "    return rank",
        "",
        "",
        "def _generate() -> list[str]:",
        "    \"\"\"All 960 back ranks as piece-type lists, in SPN order.\"\"\"",
        "    ranks: list[list] = []",
        "    for b1 in range(8):",
        "        for b2 in range(b1 + 1, 8):",
        "            if (b1 + b2) % 2 == 0:",
        "                continue  # bishops must be on opposite colors",
        "            empty = [f for f in range(8) if f != b1 and f != b2]",
        "            for kf in range(len(empty) - 1):",
        "                for rf1 in range(kf + 1, len(empty) - 1):",
        "                    for rf2 in range(rf1 + 1, len(empty)):",
        "                        files = [empty[kf], empty[rf1], empty[rf2]]",
        "                        ranks.append(_back_rank(files[0], 0, ()) if False else None)",
        "                        rank = [None] * 8",
        "                        rank[b1] = PieceType.BISHOP",
        "                        rank[b2] = PieceType.BISHOP",
        "                        rank[files[0]] = PieceType.KING",
        "                        rank[files[1]] = PieceType.ROOK",
        "                        rank[files[2]] = PieceType.ROOK",
        "                        # queen on the remaining square",
        "                        for f in range(8):",
        "                            if rank[f] is None:",
        "                                rank[f] = PieceType.QUEEN",
        "                        ranks.append(rank)",
        "    return ranks",
        "",
        "",
        "# SPN 518 must be the standard position — the generator above produces the",
        "# standard order used by chess960 SPN tables.",
        "_START_RANKS: list[list] = _generate()",
        "assert len(_START_RANKS) == 960",
        "assert _START_RANKS[518] == [",
        "    PieceType.ROOK, PieceType.KNIGHT, PieceType.BISHOP, PieceType.QUEEN,",
        "    PieceType.KING, PieceType.BISHOP, PieceType.KNIGHT, PieceType.ROOK,",
        "], \"SPN 518 must be the standard chess start\"",
        "",
        "",
        "def start_board(index: int) -> Board:",
        "    \"\"\"Board for Chess960 start position number ``index`` (0-959).\"\"\"",
        "    if not 0 <= index < 960:",
        "        raise ValueError(f\"chess960 index must be in 0..959, got {index}\")",
        "    rank = _START_RANKS[index]",
        "    squares: list[Piece | None] = [None] * 64",
        "    for f, t in enumerate(rank):",
        "        squares[square(f, 0)] = Piece(t, Color.WHITE)",
        "        squares[square(f, 7)] = Piece(t, Color.BLACK)",
        "        squares[square(f, 1)] = Piece(PieceType.PAWN, Color.WHITE)",
        "        squares[square(f, 6)] = Piece(PieceType.PAWN, Color.BLACK)",
        "    # X-FEN castling rights: file letters of the rooks (standard a/h -> AQ/aq",
        "    # letters are KQkq-equivalent; we emit file letters uniformly for 960).",
        "    rooks_w = [f for f in range(8) if rank[f] is PieceType.ROOK]",
        "    rights = {\"KQkq\"}  # placeholder, replaced below",
        "    rights = set()",
        "    rights.add(\"ABCDEFGH\"[rooks_w[1]])  # kingside rook file (right of king)",
        "    rights.add(\"ABCDEFGH\"[rooks_w[0]])  # queenside rook file",
        "    rights.add(\"ABCDEFGH\"[rooks_w[1]].lower())",
        "    rights.add(\"ABCDEFGH\"[rooks_w[0]].lower())",
        "    return Board(squares=squares, turn=Color.WHITE, castling=rights)",
        "",
        "",
        "def start_fen(index: int) -> str:",
        "    \"\"\"FEN (X-FEN castling rights) of Chess960 start position ``index``.\"\"\"",
        "    return board_to_fen(start_board(index))",
        ""
      ]
