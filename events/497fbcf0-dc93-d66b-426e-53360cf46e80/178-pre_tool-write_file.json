      "content": [
        "// Chess board rendering and click-to-move interaction.",
        "// Renders the position from /api/board and sends moves to /api/move.",
        "",
        "const boardEl = document.getElementById(\"board\");",
        "const statusEl = document.getElementById(\"status\");",
        "const FILES = \"abcdefgh\";",
        "",
        "let selected = null; // currently selected square name, e.g. \"e2\"",
        "let glyphs = {}; // square name -> unicode piece glyph",
        "",
        "function squareName(file, rank) {",
        "  return FILES[file] + (rank + 1);",
        "}",
        "",
        "function render(data) {",
        "  boardEl.innerHTML = \"\";",
        "  glyphs = data.glyphs || {};",
        "  for (let rank = 7; rank >= 0; rank--) {",
        "    for (let file = 0; file < 8; file++) {",
        "      const name = squareName(file, rank);",
        "      const sq = document.createElement(\"div\");",
        "      sq.className = \"square \" + ((file + rank) % 2 === 0 ? \"light\" : \"dark\");",
        "      sq.dataset.square = name;",
        "      if (name === selected) sq.classList.add(\"selected\");",
        "      const glyph = glyphs[name];",
        "      if (glyph) {",
        "        const span = document.createElement(\"span\");",
        "        span.className = \"piece\";",
        "        span.textContent = glyph;",
        "        sq.appendChild(span);",
        "      }",
        "      sq.addEventListener(\"click\", () => onSquareClick(name));",
        "      boardEl.appendChild(sq);",
        "    }",
        "  }",
        "}",
        "",
        "function setStatus(text) {",
        "  statusEl.textContent = text;",
        "}",
        "",
        "async function refresh() {",
        "  try {",
        "    const [board, status] = await Promise.all([ChessAPI.board(), ChessAPI.status()]);",
        "    render(board);",
        "    const turn = status.turn === \"w\" ? \"White\" : \"Black\";",
        "    const check = status.in_check ? \" — CHECK!\" : \"\";",
        "    setStatus(",
        "      `${turn} to move${check} — result: ${status.result} — ${status.legal_move_count} legal moves`",
        "    );",
        "  } catch (err) {",
        "    setStatus(\"Error: \" + err.message);",
        "  }",
        "}",
        "",
        "async function onSquareClick(name) {",
        "  if (!selected) {",
        "    selected = name;",
        "  } else if (selected === name) {",
        "    selected = null;",
        "  } else {",
        "    let uci = selected + name;",
        "    // Default to queen promotion when a pawn reaches the last rank.",
        "    const glyph = glyphs[selected];",
        "    if ((glyph === \"♙\" && name.endsWith(\"8\")) || (glyph === \"♟\" && name.endsWith(\"1\"))) {",
        "      uci += \"q\";",
        "    }",
        "    const from = selected;",
        "    selected = null;",
        "    try {",
        "      await ChessAPI.move(uci);",
        "    } catch (err) {",
        "      setStatus(`Illegal move ${uci}: ${err.message}`);",
        "    }",
        "  }",
        "  await refresh();",
        "}",
        "",
        "document.getElementById(\"btn-new\").addEventListener(\"click\", async () => {",
        "  selected = null;",
        "  await ChessAPI.newGame();",
        "  await refresh();",
        "});",
        "document.getElementById(\"btn-undo\").addEventListener(\"click\", async () => {",
        "  selected = null;",
        "  try {",
        "    await ChessAPI.undo();",
        "  } catch (err) {",
        "    setStatus(\"Undo: \" + err.message);",
        "  }",
        "  await refresh();",
        "});",
        "",
        "refresh();",
        ""
      ]
    }
  }
}
