      "content": [
        "\"\"\"Board representation and square helpers.",
        "",
        "Squares are indexed 0..63 with 0 = a1, 7 = h1, 56 = a8, 63 = h8",
        "(``square = rank * 8 + file``, file and rank 0-based).",
        "\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from dataclasses import dataclass, field",
        "",
        "from chess.engine.pieces import Color, Piece, PieceType",
        "",
        "FILES = \"abcdefgh\"",
        "RANKS = \"12345678\"",
        "",
        "",
        "def square(file: int, rank: int) -> int:",
        "    \"\"\"Index of the square at 0-based ``file`` (0 = a) and ``rank`` (0 = 1).\"\"\"",
        "    if not (0 <= file < 8 and 0 <= rank < 8):",
        "        raise ValueError(f\"file/rank out of range: {file}, {rank}\")",
        "    return rank * 8 + file",
        "",
        "",
        "def square_file(sq: int) -> int:",
        "    \"\"\"0-based file (0 = a) of a square index.\"\"\"",
        "    return sq % 8",
        "",
        "",
        "def square_rank(sq: int) -> int:",
        "    \"\"\"0-based rank (0 = 1) of a square index.\"\"\"",
        "    return sq // 8",
        "",
        "",
        "def parse_square(name: str) -> int:",
        "    \"\"\"Parse an algebraic square name (``\"e2\"``) to its index.\"\"\"",
        "    if len(name) != 2 or name[0] not in FILES or name[1] not in RANKS:",
        "        raise ValueError(f\"invalid square name: {name!r} (expected e.g. 'e2')\")",
        "    return square(FILES.index(name[0]), RANKS.index(name[1]))",
        "",
        "",
        "def square_name(sq: int) -> str:",
        "    \"\"\"Algebraic name of a square index (0 -> ``\"a1\"``).\"\"\"",
        "    if not 0 <= sq < 64:",
        "        raise ValueError(f\"invalid square index: {sq}\")",
        "    return FILES[sq % 8] + RANKS[sq // 8]",
        "",
        "",
        "@dataclass",
        "class Board:",
        "    \"\"\"Full board state: pieces, side to move, castling rights, en-passant",
        "    square and move counters.\"\"\"",
        "",
        "    squares: list[Piece | None] = field(default_factory=lambda: [None] * 64)",
        "    turn: Color = Color.WHITE",
        "    castling: set[str] = field(default_factory=lambda: {\"K\", \"Q\", \"k\", \"q\"})",
        "    ep_square: int | None = None",
        "    halfmove_clock: int = 0",
        "    fullmove_number: int = 1",
        "",
        "    @classmethod",
        "    def initial(cls) -> Board:",
        "        \"\"\"Standard starting position.\"\"\"",
        "        board = cls()",
        "        back_rank = (",
        "            PieceType.ROOK,",
        "            PieceType.KNIGHT,",
        "            PieceType.BISHOP,",
        "            PieceType.QUEEN,",
        "            PieceType.KING,",
        "            PieceType.BISHOP,",
        "            PieceType.KNIGHT,",
        "            PieceType.ROOK,",
        "        )",
        "        for f in range(8):",
        "            board.squares[square(f, 0)] = Piece(back_rank[f], Color.WHITE)",
        "            board.squares[square(f, 1)] = Piece(PieceType.PAWN, Color.WHITE)",
        "            board.squares[square(f, 6)] = Piece(PieceType.PAWN, Color.BLACK)",
        "            board.squares[square(f, 7)] = Piece(back_rank[f], Color.BLACK)",
        "        return board",
        "",
        "    def piece_at(self, sq: int) -> Piece | None:",
        "        \"\"\"Piece on square ``sq``, or None if empty.\"\"\"",
        "        return self.squares[sq]",
        "",
        "    def set_piece(self, sq: int, piece: Piece | None) -> None:",
        "        \"\"\"Place (or remove, with None) a piece on square ``sq``.\"\"\"",
        "        self.squares[sq] = piece",
        "",
        "    def copy(self) -> Board:",
        "        \"\"\"Independent copy of the board.\"\"\"",
        "        return Board(",
        "            list(self.squares),",
        "            self.turn,",
        "            set(self.castling),",
        "            self.ep_square,",
        "            self.halfmove_clock,",
        "            self.fullmove_number,",
        "        )",
        "",
        "    def king_square(self, color: Color) -> int:",
        "        \"\"\"Square of the king of ``color``.\"\"\"",
        "        for sq, piece in enumerate(self.squares):",
        "            if piece is not None and piece.type is PieceType.KING and piece.color is color:",
        "                return sq",
        "        raise ValueError(f\"no {color} king on the board\")",
        "",
        "    def ascii(self) -> str:",
        "        \"\"\"Human-readable ASCII rendering, rank 8 at the top.\"\"\"",
        "        lines = []",
        "        for rank in range(7, -1, -1):",
        "            row = \" \".join(",
        "                self.squares[square(f, rank)].symbol",
        "                if self.squares[square(f, rank)] is not None",
        "                else \".\"",
        "                for f in range(8)",
        "            )",
        "            lines.append(f\"{RANKS[rank]}  {row}\")",
        "        lines.append(\"   \" + \" \".join(FILES))",
        "        return \"\\n\".join(lines)",
        ""
      ]
    },
