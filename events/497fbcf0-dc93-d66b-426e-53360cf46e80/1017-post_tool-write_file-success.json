      "content": [
        "\"\"\"Generate a VERIFIED puzzle database for chess/ai/puzzles.py.",
        "",
        "Scans random short games: a position is kept as a puzzle only if",
        "find_mates(board, n) has exactly one move (the solution). Output: Python literal.",
        "\"\"\"",
        "import json",
        "import random",
        "import sys",
        "",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "",
        "from chess.ai.evaluation import VALUES",
        "from chess.ai.mate import can_mate_in, find_mates",
        "from chess.ai.search import best_move",
        "from chess.engine.board import Board",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import apply_move",
        "",
        "random.seed(20240607)",
        "",
        "THEME_BY_PIECE = {",
        "    \"Q\": \"Mat à la dame\",",
        "    \"R\": \"Mat à la tour\",",
        "    \"N\": \"Mat du cavalier\",",
        "    \"B\": \"Mat du fou\",",
        "    \"P\": \"Mat du pion\",",
        "    \"K\": \"Mat aidé\",",
        "}",
        "",
        "",
        "def material_balance(board):",
        "    bal = 0",
        "    for sq, p in enumerate(board.squares):",
        "        if p is None:",
        "            continue",
        "        v = VALUES[p.type]",
        "        bal += v if p.color.value == \"w\" else -v",
        "    return bal",
        "",
        "",
        "def scan(n_wanted, max_n, min_material=0, max_positions=4000, label=\"\"):",
        "    found = []",
        "    scanned = 0",
        "    while len(found) < n_wanted and scanned < max_positions:",
        "        scanned += 1",
        "        board = Board.initial()",
        "        for ply in range(80):",
        "            if can_mate_in(board, 1):",
        "                break",
        "            side = board.turn.value",
        "            if max_n >= 2 and min_material and side == \"w\" and material_balance(board) < min_material:",
        "                # still scan cheaply only if close to mate",
        "                pass",
        "            moves = find_mates(board, max_n) if (max_n >= 2 and scanned % 1 == 0 and material_ok(board, min_material, max_n)) else []",
        "            if max_n == 1:",
        "                moves = find_mates(board, 1)",
        "            if len(moves) == 1:",
        "                found.append((board_to_fen(board), moves[0].to_uci(), board.piece_at(moves[0].from_sq).symbol))",
        "                print(f\"  [{label}] found #{len(found)}: {board_to_fen(board)} sol={moves[0].to_uci()}\", flush=True)",
        "                if len(found) >= n_wanted:",
        "                    break",
        "            # play a random-ish game move",
        "            try:",
        "                mv, _, _ = best_move(board, 1)",
        "            except ValueError:",
        "                break",
        "            board = apply_move(board, mv)",
        "            if can_mate_in(board, 1):",
        "                break",
        "    return found",
        "",
        "",
        "def material_ok(board, min_material, max_n):",
        "    if max_n == 1:",
        "        return True",
        "    bal = material_balance(board)",
        "    return (board.turn.value == \"w\" and bal >= min_material) or (board.turn.value == \"b\" and bal <= -min_material)",
        "",
        "",
        "def main():",
        "    out = {1: [], 2: [], 3: []}",
        "    print(\"scanning mate-in-1...\", flush=True)",
        "    out[1] = scan(12, 1)",
        "    print(\"scanning mate-in-2...\", flush=True)",
        "    out[2] = scan(12, 2, min_material=2, max_positions=600)",
        "    print(\"scanning mate-in-3 (slow)...\", flush=True)",
        "    out[3] = scan(8, 3, min_material=5, max_positions=120)",
        "",
        "    puzzles = []",
        "    for level, items in out.items():",
        "        for fen, sol, sym in items:",
        "            puzzles.append({\"fen\": fen, \"solution\": sol, \"level\": level, \"theme\": THEME_BY_PIECE.get(sym.upper(), \"Mat forcé\")})",
        "    with open(\"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\", \"w\") as f:",
        "        json.dump(puzzles, f, indent=2, ensure_ascii=False)",
        "    print(f\"TOTAL: {len(puzzles)} (l1={len(out[1])}, l2={len(out[2])}, l3={len(out[3])})\")",
        "",
        "",
        "if __name__ == \"__main__\":",
        "    main()",
        ""
      ]
    },
