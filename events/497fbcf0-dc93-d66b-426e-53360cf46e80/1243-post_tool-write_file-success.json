      "content": [
        "\"\"\"Tests for the game review (chess/ai/analysis.py) and openings (V9).\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "import json",
        "",
        "import pytest",
        "",
        "from chess.ai.analysis import (",
        "    BLUNDER_CP,",
        "    LABEL_BEST,",
        "    LABEL_BLUNDER,",
        "    LABEL_BRILLIANT,",
        "    analyze_game,",
        ")",
        "from chess.cli.main import main",
        "from chess.engine.game import Game",
        "from chess.engine.openings import OPENINGS, lookup_opening",
        "from chess.engine.pgn import import_pgn",
        "",
        "OPERA_PGN = \"\"\"[Event \"Opera\"]",
        "[Result \"1-0\"]",
        "",
        "1. e4 e5 2. Nf3 d6 3. d4 Bg4 4. dxe5 Bxf3 5. Qxf3 dxe5 6. Bc4 Nf6",
        "7. Qb3 Qe7 8. Nc3 c6 9. Bg5 b5 10. Nxb5 cxb5 11. Bxb5+ Nbd7",
        "12. O-O-O Rd8 13. Rxd7 Rxd7 14. Rd1 Qe6 15. Bxd7+ Nxd7 16. Qb8+ Nxb8",
        "17. Rd8# 1-0",
        "\"\"\"",
        "",
        "",
        "def run_cli(capsys, *argv: str):",
        "    rc = main(list(argv))",
        "    out = capsys.readouterr()",
        "    return rc, out.out, out.err",
        "",
        "",
        "def test_every_opening_line_is_legal() -> None:",
        "    assert len(OPENINGS) >= 50",
        "    for code, name, line in OPENINGS:",
        "        game = Game()",
        "        for uci in line:",
        "            game.play_uci(uci)  # raises if illegal",
        "        assert game.moves, code",
        "",
        "",
        "def test_lookup_opening_longest_prefix() -> None:",
        "    assert lookup_opening([\"e2e4\", \"c7c5\", \"g1f3\", \"d7d6\", \"d2d4\", \"c5d4\",",
        "                          \"f3d4\", \"g8f6\", \"b1c3\", \"a7a6\"]) == {",
        "        \"code\": \"B90\", \"name\": \"Sicilienne, variante Najdorf\", \"matched_plies\": 10",
        "    }",
        "    assert lookup_opening([\"e2e4\", \"c7c5\"])[\"code\"] == \"B20\"",
        "    assert lookup_opening([\"e2e4\"]) is None",
        "    assert lookup_opening([]) is None",
        "    assert lookup_opening([\"d2d4\", \"d7d5\", \"c2c4\", \"e7e6\", \"b1c3\", \"g8f6\",",
        "                          \"g1f3\", \"f8e7\", \"c1f4\"])[\"code\"] == \"D37\"",
        "",
        "",
        "def test_analyze_opera_game() -> None:",
        "    game = import_pgn(OPERA_PGN)",
        "    report = analyze_game(game, depth=2)",
        "    assert len(report[\"plies\"]) == 33",
        "    assert set(report[\"accuracy\"]) == {\"w\", \"b\"}",
        "    for ply in report[\"plies\"]:",
        "        assert ply[\"label\"] in {",
        "            LABEL_BEST, \"excellent\", \"bon\", \"imprécision ?!\", \"erreur ?\",",
        "            LABEL_BLUNDER, LABEL_BRILLIANT,",
        "        }",
        "        assert ply[\"loss\"] >= 0",
        "    last = report[\"plies\"][-1]",
        "    assert last[\"san\"].rstrip(\"+#\").endswith(\"Rd8\") or \"Rd8\" in last[\"san\"]",
        "    assert last[\"label\"] == LABEL_BEST  # Rd8# is the best (mating) move",
        "",
        "",
        "def test_analyze_detects_a_blunder() -> None:",
        "    game = Game()",
        "    for mv in [\"e2e4\", \"e7e5\", \"d1h5\", \"b8c6\", \"h5f7\", \"e8f7\"]:  # Qxf7+?? Kxf7 loses the queen",
        "        game.play_uci(mv)",
        "    report = analyze_game(game, depth=2)",
        "    qxf7 = report[\"plies\"][4]",
        "    assert qxf7[\"san\"].startswith(\"Qxf7\")",
        "    assert qxf7[\"loss\"] >= BLUNDER_CP",
        "    assert qxf7[\"label\"] == LABEL_BLUNDER",
        "",
        "",
        "def test_brilliant_label_on_queen_sacrifice() -> None:",
        "    # Opera game, position before 16. Qb8+!! (queen sac leading to mate)",
        "    full = import_pgn(OPERA_PGN)",
        "    fens = full.position_fens()",
        "    game = Game.from_fen(fens[-3])",
        "    game.play_uci(\"b3b8\")  # Qb8+",
        "    report = analyze_game(game, depth=4)",
        "    ply = report[\"plies\"][0]",
        "    assert ply[\"sacrifice\"] is True",
        "    assert ply[\"label\"] == LABEL_BRILLIANT",
        "",
        "",
        "def test_cli_analyze_json(capsys, tmp_path) -> None:",
        "    state = str(tmp_path / \".chess_game.json\")",
        "    run_cli(capsys, \"--state\", state, \"new\", \"--json\")",
        "    run_cli(capsys, \"--state\", state, \"move\", \"e2e4\", \"--json\")",
        "    run_cli(capsys, \"--state\", state, \"move\", \"e7e5\", \"--json\")",
        "    rc, out, _ = run_cli(capsys, \"--state\", state, \"analyze\", \"--depth\", \"1\", \"--json\")",
        "    assert rc == 0",
        "    report = json.loads(out)",
        "    assert len(report[\"plies\"]) == 2 and report[\"depth\"] == 1",
        "    assert report[\"plies\"][0][\"san\"] == \"e4\"",
        "",
        "",
        "def test_api_analyze_and_status_opening(state) -> None:",
        "    import chess.api.server as server",
        "    from chess.api.schemas import AnalyzeRequest, MoveRequest",
        "",
        "    server.post_new()",
        "    server.post_move(MoveRequest(move=\"e2e4\"))",
        "    server.post_move(MoveRequest(move=\"c7c5\"))",
        "    st = server.get_status()",
        "    assert st[\"opening\"][\"code\"] == \"B20\"",
        "    r = server.post_analyze(AnalyzeRequest(depth=1))",
        "    assert len(r[\"plies\"]) == 2",
        ""
      ]
    },
