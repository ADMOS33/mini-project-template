      "timeout": 120,
      "command": [
        "pkill -f gen8.py; cat > /Users/rafiq/.vibe/scratchpad/gen9.py <<'EOF'",
        "\"\"\"Structured exact mate-in-n enumeration.",
        "",
        "n=2: enumerate A = (weak king in a corner, strong king at Chebyshev distance 2,",
        "strong queen anywhere) with weak side to move; keep A where EVERY weak reply",
        "allows mate in 1; step one strong move back to L (strong to move) and keep L",
        "if find_mates(L,2) is unique and find_mates(L,1) is empty (exact mate in 2).",
        "n=3: same with all replies allowing mate in <= 2, then exact mate in 3.",
        "\"\"\"",
        "import json, os, sys, time, traceback",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.mate import find_mates",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import apply_move, is_square_attacked, legal_moves",
        "from chess.engine.board import Board, square, square_file, square_rank",
        "from chess.engine.pieces import Color, PieceType",
        "",
        "OUT = \"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\"",
        "DEADLINE = time.time() + 18 * 60",
        "THEME = {\"Q\": \"Mat a la dame\", \"R\": \"Mat a la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aide\"}",
        "CORNERS = [0, 7, 56, 63]  # a1 h1 a8 h8",
        "",
        "def make_board(sqs, turn):",
        "    rows = []",
        "    for r in range(7, -1, -1):",
        "        row, e = \"\", 0",
        "        for f in range(8):",
        "            p = sqs[r * 8 + f]",
        "            if p is None: e += 1",
        "            else:",
        "                if e: row += str(e); e = 0",
        "                row += p",
        "        if e: row += str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows) + f\" {turn} - - 0 1\")",
        "",
        "def enum_A(pieces):",
        "    \"\"\"Yield A boards: weak black king in a corner, white king at Chebyshev",
        "    distance 2, plus `pieces` (letters, white) anywhere; black to move.\"\"\"",
        "    for kb in CORNERS:",
        "        kf, kr = square_file(kb), square_rank(kb)",
        "        for ks in range(64):",
        "            if max(abs(square_file(ks) - kf), abs(square_rank(ks) - kr)) != 2:",
        "                continue",
        "            base = [None] * 64",
        "            base[kb] = \"k\"",
        "            base[ks] = \"K\"",
        "            empties = [s for s in range(64) if base[s] is None]",
        "            if len(pieces) > len(empties):",
        "                continue",
        "            # place extra pieces on a subset of empties (all combos if small)",
        "            import itertools",
        "            for combo in itertools.combinations(empties, len(pieces)):",
        "                sqs = list(base)",
        "                ok = True",
        "                for letter, s in zip(pieces, combo):",
        "                    sqs[s] = letter",
        "                try:",
        "                    b = make_board(sqs, \"b\")",
        "                except ValueError:",
        "                    continue",
        "                # white king (not to move) may not be attacked",
        "                if is_square_attacked(b, b.king_square(Color.WHITE), Color.BLACK):",
        "                    continue",
        "                yield b",
        "",
        "def all_replies_mated_in(A, n):",
        "    replies = legal_moves(A)",
        "    if not replies:",
        "        return False",
        "    for r in replies:",
        "        if not find_mates(apply_move(A, r), n):",
        "            return False",
        "    return True",
        "",
        "def reverse_strong_moves(A):",
        "    out = []",
        "    for sq, p in enumerate(A.squares):",
        "        if p is None or p.color is not Color.WHITE or p.type is PieceType.PAWN:",
        "            continue",
        "        f, r = square_file(sq), square_rank(sq)",
        "        cands = []",
        "        if p.type is PieceType.KING:",
        "            for df in (-1, 0, 1):",
        "                for dr in (-1, 0, 1):",
        "                    if df or dr: cands.append((f + df, r + dr))",
        "        elif p.type is PieceType.KNIGHT:",
        "            for df, dr in ((1,2),(2,1),(2,-1),(1,-2),(-1,-2),(-2,-1),(-2,1),(-1,2)):",
        "                cands.append((f + df, r + dr))",
        "        else:",
        "            dirs = []",
        "            if p.type in (PieceType.ROOK, PieceType.QUEEN): dirs += [(1,0),(-1,0),(0,1),(0,-1)]",
        "            if p.type in (PieceType.BISHOP, PieceType.QUEEN): dirs += [(1,1),(1,-1),(-1,1),(-1,-1)]",
        "            for df, dr in dirs:",
        "                nf, nr = f + df, r + dr",
        "                while 0 <= nf < 8 and 0 <= nr < 8:",
        "                    cands.append((nf, nr))",
        "                    if A.squares[square(nf, nr)] is not None: break",
        "                    nf += df; nr += dr",
        "        for nf, nr in cands:",
        "            if not (0 <= nf < 8 and 0 <= nr < 8): continue",
        "            tsq = square(nf, nr)",
        "            if A.squares[tsq] is not None: continue",
        "            sqs = list(A.squares)",
        "            sqs[tsq] = p",
        "            sqs[sq] = None",
        "            try:",
        "                L = make_board([(\"K\" if (s is not None and s == \"K\") else s) for s in sqs], \"w\")",
        "                L = make_board(sqs, \"w\")",
        "            except ValueError:",
        "                continue",
        "            if is_square_attacked(L, L.king_square(Color.BLACK), Color.WHITE):",
        "                continue",
        "            out.append(L)",
        "    return out",
        "",
        "def save(puzzles):",
        "    json.dump(puzzles, open(OUT, \"w\"), indent=2, ensure_ascii=False)",
        "",
        "all_found = []",
        "if os.path.exists(OUT):",
        "    all_found = [p for p in json.load(open(OUT)) if p[\"level\"] == 1]",
        "    save(all_found)",
        "print(f\"resume with {len(all_found)} l1\", flush=True)",
        "",
        "def collect(n, wanted, piece_sets):",
        "    have = sum(1 for q in all_found if q[\"level\"] == n)",
        "    found = []",
        "    t0 = time.time()",
        "    seen = set()",
        "    for pieces in piece_sets:",
        "        for A in enum_A(pieces):",
        "            if time.time() > DEADLINE or have + len(found) >= wanted:",
        "                break",
        "            try:",
        "                if not all_replies_mated_in(A, n - 1):",
        "                    continue",
        "                for L in reverse_strong_moves(A):",
        "                    key = board_to_fen(L)",
        "                    if key in seen:",
        "                        continue",
        "                    seen.add(key)",
        "                    if find_mates(L, n - 1):",
        "                        continue",
        "                    ms = find_mates(L, n)",
        "                    if len(ms) == 1:",
        "                        p = L.piece_at(ms[0].from_sq)",
        "                        found.append({\"fen\": key, \"solution\": ms[0].to_uci(), \"level\": n,",
        "                                      \"theme\": THEME.get(p.symbol.upper() if p else \"?\", \"Mat force\")})",
        "                        print(f\"n={n} #{len(found)} ({time.time()-t0:.0f}s): {key} sol={ms[0].to_uci()}\", flush=True)",
        "                        save(all_found + found)",
        "                        break",
        "            except Exception:",
        "                traceback.print_exc()",
        "        if have + len(found) >= wanted:",
        "            break",
        "    return found",
        "",
        "try:",
        "    r = collect(2, 12, [[\"Q\"], [\"R\"], [\"Q\", \"R\"]])",
        "    all_found += r",
        "    r = collect(3, 8, [[\"Q\"], [\"Q\", \"R\"], [\"R\", \"R\"]])",
        "    all_found += r",
        "    save(all_found)",
        "    print(f\"TOTAL {len(all_found)}: l1={sum(1 for p in all_found if p['level']==1)} \"",
        "          f\"l2={sum(1 for p in all_found if p['level']==2)} l3={sum(1 for p in all_found if p['level']==3)}\", flush=True)",
        "except Exception:",
        "    traceback.print_exc()",
        "EOF",
        "echo ok"
      ]
    },
