      "content": [
        "\"\"\"Chess960 (V12): the 960 legal starting positions (SPN 0-959).",
        "",
        "Rules for a start position: bishops on opposite-colored squares, the king",
        "between the two rooks. SPN 518 is the standard chess position, SPN 0 is",
        "BBQNNRKR. Numbering: N = 96*K + 16*Q + 4*D + L where D/L are the dark/light",
        "bishop squares (0-3), Q the queen square among the remaining 6, K the knight",
        "pair among the remaining 5 (lexicographic combinations).",
        "\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from itertools import combinations",
        "",
        "from chess.engine.board import Board, square",
        "from chess.engine.fen import board_to_fen",
        "from chess.engine.pieces import Color, Piece, PieceType",
        "",
        "_DARK_FILES = (0, 2, 4, 6)    # a, c, e, g (a1 is a dark square)",
        "_LIGHT_FILES = (1, 3, 5, 7)   # b, d, f, h",
        "",
        "",
        "def _generate() -> list[list[PieceType | None]]:",
        "    ranks: list[list[PieceType | None] | None] = [None] * 960",
        "    for d, df in enumerate(_DARK_FILES):",
        "        for l, lf in enumerate(_LIGHT_FILES):",
        "            remaining = [f for f in range(8) if f != df and f != lf]",
        "            for q, qf in enumerate(remaining):",
        "                rem2 = [f for f in remaining if f != qf]",
        "                for k, kn in enumerate(combinations(rem2, 2)):",
        "                    rem3 = [f for f in rem2 if f not in kn]",
        "                    rank: list[PieceType | None] = [None] * 8",
        "                    rank[df] = PieceType.BISHOP",
        "                    rank[lf] = PieceType.BISHOP",
        "                    rank[qf] = PieceType.QUEEN",
        "                    rank[kn[0]] = PieceType.KNIGHT",
        "                    rank[kn[1]] = PieceType.KNIGHT",
        "                    rank[rem3[0]] = PieceType.ROOK",
        "                    rank[rem3[2]] = PieceType.ROOK",
        "                    rank[rem3[1]] = PieceType.KING",
        "                    ranks[96 * k + 16 * q + 4 * d + l] = rank",
        "    assert all(r is not None for r in ranks)",
        "    return ranks  # type: ignore[return-value]",
        "",
        "",
        "_START_RANKS: list[list[PieceType | None]] = _generate()",
        "assert len({tuple(r) for r in _START_RANKS}) == 960",
        "assert _START_RANKS[518] == [",
        "    PieceType.ROOK, PieceType.KNIGHT, PieceType.BISHOP, PieceType.QUEEN,",
        "    PieceType.KING, PieceType.BISHOP, PieceType.KNIGHT, PieceType.ROOK,",
        "], \"SPN 518 must be the standard chess start\"",
        "assert _START_RANKS[0] == [",
        "    PieceType.BISHOP, PieceType.BISHOP, PieceType.QUEEN, PieceType.KNIGHT,",
        "    PieceType.KNIGHT, PieceType.ROOK, PieceType.KING, PieceType.ROOK,",
        "], \"SPN 0 must be BBQNNRKR\"",
        "",
        "",
        "def start_board(index: int) -> Board:",
        "    \"\"\"Board for Chess960 start position number ``index`` (0-959).",
        "",
        "    Castling rights use X-FEN file letters (the file of each rook).",
        "    \"\"\"",
        "    if not 0 <= index < 960:",
        "        raise ValueError(f\"chess960 index must be in 0..959, got {index}\")",
        "    rank = _START_RANKS[index]",
        "    squares: list[Piece | None] = [None] * 64",
        "    for f, t in enumerate(rank):",
        "        squares[square(f, 0)] = Piece(t, Color.WHITE)",
        "        squares[square(f, 7)] = Piece(t, Color.BLACK)",
        "        squares[square(f, 1)] = Piece(PieceType.PAWN, Color.WHITE)",
        "        squares[square(f, 6)] = Piece(PieceType.PAWN, Color.BLACK)",
        "    rook_files = sorted(f for f in range(8) if rank[f] is PieceType.ROOK)",
        "    rights = {",
        "        \"ABCDEFGH\"[rook_files[1]], \"ABCDEFGH\"[rook_files[0]],",
        "        \"ABCDEFGH\"[rook_files[1]].lower(), \"ABCDEFGH\"[rook_files[0]].lower(),",
        "    }",
        "    return Board(squares=squares, turn=Color.WHITE, castling=rights)",
        "",
        "",
        "def start_fen(index: int) -> str:",
        "    \"\"\"FEN (X-FEN castling rights) of Chess960 start position ``index``.\"\"\"",
        "    return board_to_fen(start_board(index))",
        ""
      ]
    }
