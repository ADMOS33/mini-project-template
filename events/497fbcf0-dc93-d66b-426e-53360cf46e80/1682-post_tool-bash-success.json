        "cd /Users/rafiq/3A/projet-AI/mini-project-template && .venv/bin/python - <<'EOF'",
        "import random, sys, time",
        "sys.path.insert(0, \".\")",
        "from chess.ai.mate import find_mates, is_checkmate",
        "from chess.engine.fen import board_from_fen",
        "from chess.engine.movegen import apply_move, is_square_attacked",
        "from chess.engine.pieces import Color",
        "from collections import Counter",
        "",
        "rng = random.Random(99)",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "def build(strong, extras, weak):",
        "    sqs = [None]*64",
        "    kb = rng.choice(EDGE)",
        "    cands = [s for s in range(64) if max(abs(s%8-kb%8), abs(s//8-kb//8)) == 2]",
        "    ks = rng.choice(cands)",
        "    sqs[kb] = \"k\" if strong==\"w\" else \"K\"; sqs[ks] = \"K\" if strong==\"w\" else \"k\"",
        "    for letter in extras:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter if strong==\"w\" else letter.lower()",
        "    for letter in weak:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter.lower() if strong==\"w\" else letter.upper()",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    try: b=board_from_fen(\"/\".join(rows)+f\" {strong} - - 0 1\")",
        "    except ValueError: return None",
        "    wc = Color.BLACK if strong==\"w\" else Color.WHITE",
        "    if is_square_attacked(b, b.king_square(wc), Color.WHITE if strong==\"w\" else Color.BLACK): return None",
        "    return b",
        "",
        "t0=time.time(); tries=0; nomate1=0; exact=0; examples=[]",
        "sets = [[\"Q\",\"R\"],[\"Q\"],[\"R\",\"R\"],[\"Q\",\"B\"],[\"Q\",\"N\"],[\"B\",\"B\"],[\"R\",\"B\"]]",
        "weaks = [[],[\"p\"],[\"r\"],[\"n\"],[\"p\",\"p\"],[\"b\"]]",
        "while time.time()-t0 < 50:",
        "    tries += 1",
        "    b = build(\"w\", rng.choice(sets), rng.choice(weaks))",
        "    if b is None: continue",
        "    if find_mates(b, 1): continue",
        "    nomate1 += 1",
        "    ms = find_mates(b, 2)",
        "    if len(ms)==1:",
        "        exact += 1",
        "        if len(examples) < 5:",
        "            from chess.engine.fen import board_to_fen",
        "            examples.append((board_to_fen(b), ms[0].to_uci()))",
        "print(f\"tries={tries} no-mate-in-1={nomate1} exact-mate-in-2={exact} in {time.time()-t0:.0f}s\")",
        "for e in examples: print(e)",
        "EOF"
      ]
    },
