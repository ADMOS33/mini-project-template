        "  } else {",
        "    openNewGameModal();",
        "  }",
        "});",
        "document.getElementById(\"btn-gameover-review\").addEventListener(\"click\", () => {",
        "  document.getElementById(\"gameover-modal\").classList.add(\"hidden\");",
        "  state.reviewPly = 0; // retour au début de la partie pour la revoir",
        "  renderAll();",
