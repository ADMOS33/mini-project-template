        "        const uciMoves = state.legalMoves.filter((m) => m.startsWith(from + name));",
        "        if (uciMoves.length > 0) {",
        "          state.premove = { from, to: name, uci: uciMoves[0] };",
        "          render();",
        "          toast(`Prémouvement enregistré : ${from}-${name} (partira dès votre tour).`, \"info\");",
