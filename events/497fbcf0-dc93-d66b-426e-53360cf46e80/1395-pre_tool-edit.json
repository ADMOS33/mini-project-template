        "    const name = squareFromEvent(e);",
        "    if (!name) return;",
        "    if (!state.selected) {",
        "      if (myPieceAt(name)) state.selected = name;",
        "      else {",
        "        // clic gauche sur une case vide sans sélection : efface les dessins (V10)",
        "        state.drawings = [];",
