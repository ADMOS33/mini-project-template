        "import random, sys, time",
        "sys.path.insert(0, \".\")",
        "from chess.ai.mate import find_mates, is_checkmate",
        "from chess.engine.fen import board_from_fen",
        "from chess.engine.movegen import apply_move, is_square_attacked",
        "from chess.engine.pieces import Color",
        "",
        "rng = random.Random(1)",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "",
        "def build(strong, extras, weak):",
        "    sqs = [None]*64",
        "    kb = rng.choice(EDGE)",
        "    cands = [s for s in range(64) if max(abs(s%8-kb%8), abs(s//8-kb//8)) == 2]",
        "    ks = rng.choice(cands)",
        "    sqs[kb] = \"k\" if strong==\"w\" else \"K\"",
        "    sqs[ks] = \"K\" if strong==\"w\" else \"k\"",
        "    for letter in extras:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter if strong==\"w\" else letter.lower()",
        "    for letter in weak:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is not None: return None",
        "        sqs[s] = letter.lower() if strong==\"w\" else letter.upper()",
        "    rows=[]",
        "    for r in range(7,-1,-1):",
        "        row,e=\"\",0",
        "        for f in range(8):",
        "            p=sqs[r*8+f]",
        "            if p is None: e+=1",
        "            else:",
        "                if e: row+=str(e); e=0",
        "                row+=p",
        "        if e: row+=str(e)",
        "        rows.append(row)",
        "    fen=\"/\".join(rows)+f\" {strong} - - 0 1\"",
        "    try: b=board_from_fen(fen)",
        "    except ValueError: return None",
        "    wc = Color.BLACK if strong==\"w\" else Color.WHITE",
        "    if is_square_attacked(b, b.king_square(wc), Color.WHITE if strong==\"w\" else Color.BLACK): return None",
        "    return b",
        "",
        "t0=time.time(); hits=0; tries=0; valid=0",
        "sets2 = [[\"Q\",\"R\"],[\"Q\"],[\"R\",\"R\"],[\"Q\",\"B\"]]",
        "weaks = [[],[\"p\"],[\"r\"]]",
        "while tries < 400 and time.time()-t0 < 25:",
        "    tries += 1",
        "    b = build(\"w\", rng.choice(sets2), rng.choice(weaks))",
        "    if b is None: continue",
        "    valid += 1",
        "    ms = find_mates(b, 2)",
        "    if len(ms)==1 and not is_checkmate(apply_move(b, ms[0])):",
        "        hits += 1",
        "print(f\"tries={tries} valid={valid} exact-mate-in-2 hits={hits} in {time.time()-t0:.1f}s\")",
        "EOF"
      ]
