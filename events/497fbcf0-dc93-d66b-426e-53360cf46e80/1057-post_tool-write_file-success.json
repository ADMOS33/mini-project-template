      "content": [
        "\"\"\"Tests for forced-mate search (chess/ai/mate.py).\"\"\"",
        "",
        "from __future__ import annotations",
        "",
        "from chess.ai.mate import best_defense, can_mate_in, find_mates, mate_distance",
        "from chess.engine.board import Board",
        "from chess.engine.fen import board_from_fen",
        "from chess.engine.pgn import import_pgn",
        "",
        "OPERA_PGN = \"\"\"[Event \"Opera\"]",
        "[Result \"1-0\"]",
        "",
        "1. e4 e5 2. Nf3 d6 3. d4 Bg4 4. dxe5 Bxf3 5. Qxf3 dxe5 6. Bc4 Nf6",
        "7. Qb3 Qe7 8. Nc3 c6 9. Bg5 b5 10. Nxb5 cxb5 11. Bxb5+ Nbd7",
        "12. O-O-O Rd8 13. Rxd7 Rxd7 14. Rd1 Qe6 15. Bxd7+ Nxd7 16. Qb8+ Nxb8",
        "17. Rd8# 1-0",
        "\"\"\"",
        "",
        "",
        "def test_fools_mate_is_the_only_mate_in_1() -> None:",
        "    # After 1. f3 e5 2. g4, Black mates with Qh4# and nothing else.",
        "    board = board_from_fen(\"rnbqkbnr/pppp1ppp/8/4p3/6P1/5P2/PPPPP2P/RNBQKBNR b KQkq - 0 2\")",
        "    mates = find_mates(board, 1)",
        "    assert [m.to_uci() for m in mates] == [\"d8h4\"]",
        "    assert can_mate_in(board, 1)",
        "",
        "",
        "def test_scholars_mate_is_the_only_mate_in_1() -> None:",
        "    # 1. e4 e5 2. Bc4 Nc6 3. Qh5: Qxf7# is the only mate.",
        "    board = board_from_fen(\"r1bqkbnr/pppp1ppp/2n5/4p2Q/2B1P3/8/PPPP1PPP/RNB1K1NR w KQkq - 4 3\")",
        "    assert [m.to_uci() for m in find_mates(board, 1)] == [\"h5f7\"]",
        "",
        "",
        "def test_opera_game_final_position_has_unique_mate() -> None:",
        "    game = import_pgn(OPERA_PGN)",
        "    fens = game.position_fens()",
        "    before_last = board_from_fen(fens[-2])  # position before 17. Rd8#",
        "    assert [m.to_uci() for m in find_mates(before_last, 1)] == [\"d1d8\"]",
        "    assert mate_distance(before_last) == 1",
        "",
        "",
        "def test_initial_position_cannot_force_quick_mate() -> None:",
        "    board = Board.initial()",
        "    assert not can_mate_in(board, 1)",
        "    assert not can_mate_in(board, 2)",
        "    assert not can_mate_in(board, 3)",
        "    assert find_mates(board, 1) == []",
        "    assert mate_distance(board, max_n=3) is None",
        "",
        "",
        "def test_best_defense_returns_a_legal_move() -> None:",
        "    board = board_from_fen(\"rnbqkbnr/pppp1ppp/8/4p3/6P1/5P2/PPPPP2P/RNBQKBNR b KQkq - 0 2\")",
        "    defense = best_defense(board, max_n=1)",
        "    assert defense.to_uci() in {m.to_uci() for m in board.legal_moves()}",
        ""
      ]
    },
