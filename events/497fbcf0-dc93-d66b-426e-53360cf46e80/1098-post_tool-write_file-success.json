      "content": [
        "\"\"\"Fast verified puzzle generation from random endgames (few pieces = fast search).\"\"\"",
        "import json, random, sys",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.evaluation import MATE_SCORE",
        "from chess.ai.mate import find_mates",
        "from chess.ai.search import _INF, negamax",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.pieces import PieceType",
        "",
        "rng = random.Random(1234)",
        "THEME = {\"Q\": \"Mat à la dame\", \"R\": \"Mat à la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aidé\"}",
        "PT = {\"Q\": PieceType.QUEEN, \"R\": PieceType.ROOK, \"N\": PieceType.KNIGHT,",
        "      \"B\": PieceType.BISHOP, \"P\": PieceType.PAWN}",
        "",
        "def sq_name(s):",
        "    return \"abcdefgh\"[s % 8] + str(s // 8 + 1)",
        "",
        "def random_endgame(extras, strong_color):",
        "    \"\"\"extras: list of piece letters for the strong side; returns Board or None.\"\"\"",
        "    for _ in range(200):",
        "        squares = [None] * 64",
        "        kw, kb = rng.randrange(64), rng.randrange(64)",
        "        if max(abs(kw % 8 - kb % 8), abs(kw // 8 - kb // 8)) <= 1:",
        "            continue",
        "        squares[kw] = \"K\" if strong_color == \"w\" else \"k\"",
        "        squares[kb] = \"k\" if strong_color == \"w\" else \"K\"",
        "        ok = True",
        "        for letter in extras:",
        "            s = rng.randrange(64)",
        "            if squares[s] is not None:",
        "                ok = False",
        "                break",
        "            squares[s] = letter if strong_color == \"w\" else letter.lower()",
        "        if not ok:",
        "            continue",
        "        rows = []",
        "        for r in range(7, -1, -1):",
        "            row, empty = \"\", 0",
        "            for f in range(8):",
        "                p = squares[r * 8 + f]",
        "                if p is None:",
        "                    empty += 1",
        "                else:",
        "                    if empty:",
        "                        row += str(empty)",
        "                        empty = 0",
        "                    row += p",
        "            if empty:",
        "                row += str(empty)",
        "            rows.append(row)",
        "        fen = \"/\".join(rows) + f\" {strong_color} - - 0 1\"",
        "        try:",
        "            return board_from_fen(fen)",
        "        except ValueError:",
        "            continue",
        "    return None",
        "",
        "def quick(board, n):",
        "    score, _ = negamax(board, 2 * n, -_INF, _INF)",
        "    return score >= MATE_SCORE",
        "",
        "def collect(n, wanted, piece_sets):",
        "    found = []",
        "    tries = 0",
        "    while len(found) < wanted and tries < 4000:",
        "        tries += 1",
        "        strong = rng.choice([\"w\", \"b\"])",
        "        extras = rng.choice(piece_sets)",
        "        b = random_endgame(extras, strong)",
        "        if b is None:",
        "            continue",
        "        if not quick(b, n):",
        "            continue",
        "        ms = find_mates(b, n)",
        "        if len(ms) == 1:",
        "            found.append({\"fen\": board_to_fen(b), \"solution\": ms[0].to_uci(),",
        "                          \"level\": n, \"theme\": THEME.get(b.piece_at(ms[0].from_sq).symbol.upper(), \"Mat forcé\")})",
        "            print(f\"n={n} #{len(found)}: {board_to_fen(b)} sol={ms[0].to_uci()}\", flush=True)",
        "    return found",
        "",
        "out = {}",
        "out[1] = collect(1, 10, [[\"Q\"], [\"R\", \"R\"], [\"Q\", \"R\"], [\"Q\", \"B\"], [\"Q\", \"N\"], [\"R\", \"B\"], [\"Q\", \"P\"]])",
        "out[2] = collect(2, 10, [[\"Q\"], [\"Q\", \"R\"], [\"R\", \"R\"], [\"Q\", \"B\"], [\"Q\", \"N\"]])",
        "out[3] = collect(3, 6, [[\"Q\"], [\"Q\", \"R\"], [\"R\", \"R\"], [\"Q\", \"B\", \"B\"], [\"Q\", \"N\"]])",
        "puzzles = out[1] + out[2] + out[3]",
        "json.dump(puzzles, open(\"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\", \"w\"), indent=2, ensure_ascii=False)",
        "print(f\"TOTAL {len(puzzles)}: l1={len(out[1])} l2={len(out[2])} l3={len(out[3])}\")",
        ""
      ]
    },
