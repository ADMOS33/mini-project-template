    "tool_input": {
      "file_path": "/Users/rafiq/3A/projet-AI/mini-project-template/web/board.js",
      "content": [
        "// Chess web app: board rendering, click-click & drag-drop play, legal-move",
        "// hints, SAN history with review mode, captured pieces, clocks, vs-computer",
        "// mode, import/export and game-over modal. All game data comes from the API.",
        "",
        "const boardEl = document.getElementById(\"board\");",
        "const statusEl = document.getElementById(\"status\");",
        "const historyEl = document.getElementById(\"history\");",
        "const reviewBar = document.getElementById(\"review-bar\");",
        "const reviewLabel = document.getElementById(\"review-label\");",
        "const thinkingEl = document.getElementById(\"thinking\");",
        "const FILES = \"abcdefgh\";",
        "",
        "const GLYPHS = {",
        "  K: \"♔\", Q: \"♕\", R: \"♖\", B: \"♗\", N: \"♘\", P: \"♙\",",
        "  k: \"♚\", q: \"♛\", r: \"♜\", b: \"♝\", n: \"♞\", p: \"♟\",",
        "};",
        "const VALUES = { p: 1, n: 3, b: 3, r: 5, q: 9, k: 0 };",
        "const START_COUNTS = { p: 8, n: 2, b: 2, r: 2, q: 1, k: 1 };",
        "",
        "function ls(key, def) {",
        "  try {",
        "    return localStorage.getItem(key) ?? def;",
        "  } catch {",
        "    return def;",
        "  }",
        "}",
        "function lsSet(key, val) {",
        "  try {",
        "    localStorage.setItem(key, val);",
        "  } catch { /* ignore */ }",
        "}",
        "",
        "const state = {",
        "  boardData: null,",
        "  selected: null,",
        "  symbols: {}, // square name -> FEN symbol",
        "  turn: \"w\",",
        "  flipped: ls(\"chess.flip\", \"0\") === \"1\",",
        "  legalMoves: [],",
        "  lastMove: null, // {from, to, uci}",
        "  prevLastMoveUci: null,",
        "  inCheck: false,",
        "  drag: null,",
        "  history: [], // [{ply, uci, san, fen}]",
        "  reviewPly: null, // null = live position",
        "  vs: ls(\"chess.vs\", \"0\") === \"1\",",
        "  colorChoice: ls(\"chess.color\", \"w\"),",
        "  actualColor: \"w\", // resolved color when \"random\"",
        "  depth: parseInt(ls(\"chess.depth\", \"3\"), 10),",
        "  clockMode: ls(\"chess.clock\", \"none\"),",
        "  clock: { w: 0, b: 0, inc: 0, active: null, lastTs: null },",
        "  gameOverShownFor: null,",
        "  thinking: false,",
        "};",
        "",
        "function squareName(file, rank) {",
        "  return FILES[file] + (rank + 1);",
        "}",
        "",
        "function parseFen(fen) {",
        "  const parts = fen.split(\" \");",
        "  const rows = parts[0].split(\"/\");",
        "  const symbols = {};",
        "  for (let r = 0; r < 8; r++) {",
        "    let f = 0;",
        "    for (const ch of rows[r]) {",
        "      if (/\\d/.test(ch)) f += parseInt(ch, 10);",
        "      else {",
        "        symbols[FILES[f] + (8 - r)] = ch;",
        "        f++;",
        "      }",
        "    }",
        "  }",
        "  return { symbols, turn: parts[1] || \"w\" };",
        "}",
        "",
        "function addCoord(sqEl, cls, text) {",
        "  const c = document.createElement(\"span\");",
        "  c.className = cls;",
        "  c.textContent = text;",
        "  sqEl.appendChild(c);",
        "}",
        "",
        "function sizeBoard() {",
        "  const w = boardEl.clientWidth || 512;",
        "  boardEl.style.setProperty(\"--sq\", w / 8 + \"px\");",
        "}",
        "window.addEventListener(\"resize\", sizeBoard);",
        "",
        "function kingSquareOf(color) {",
        "  for (const [name, sym] of Object.entries(state.symbols)) {",
        "    if (sym && sym.toLowerCase() === \"k\" && (color === \"w\" ? sym === \"K\" : sym === \"k\")) {",
        "      return name;",
        "    }",
        "  }",
        "  return null;",
        "}",
        "",
        "function render() {",
        "  boardEl.innerHTML = \"\";",
        "  const symbols = state.symbols;",
        "  const ranks = state.flipped ? [0, 1, 2, 3, 4, 5, 6, 7] : [7, 6, 5, 4, 3, 2, 1, 0];",
        "  const files = state.flipped ? [7, 6, 5, 4, 3, 2, 1, 0] : [0, 1, 2, 3, 4, 5, 6, 7];",
        "  const lastFrom = state.lastMove ? state.lastMove.from : null;",
        "  const lastTo = state.lastMove ? state.lastMove.to : null;",
        "  const checkSq = state.inCheck && state.reviewPly === null ? kingSquareOf(state.turn) : null;",
        "  const hintTargets = new Map();",
        "  if (state.selected && state.reviewPly === null) {",
        "    for (const uci of state.legalMoves) {",
        "      if (uci.startsWith(state.selected)) {",
        "        const to = uci.slice(2, 4);",
        "        hintTargets.set(to, hintTargets.get(to) || Boolean(symbols[to]));",
        "      }",
        "    }",
        "  }",
        "  for (const rank of ranks) {",
        "    for (const file of files) {",
        "      const name = squareName(file, rank);",
        "      const sq = document.createElement(\"div\");",
        "      // a1 (file+rank even) is a DARK square; h1 is light.",
        "      sq.className = \"square \" + ((file + rank) % 2 === 0 ? \"dark\" : \"light\");",
        "      sq.dataset.square = name;",
        "      const isLeftEdge = state.flipped ? file === 7 : file === 0;",
        "      const isBottomEdge = state.flipped ? rank === 7 : rank === 0;",
        "      if (isLeftEdge) addCoord(sq, \"coord rank\", String(rank + 1));",
        "      if (isBottomEdge) addCoord(sq, \"coord file\", FILES[file]);",
        "      if (name === state.selected) sq.classList.add(\"selected\");",
        "      if (name === lastFrom || name === lastTo) sq.classList.add(\"last-move\");",
        "      if (name === checkSq) sq.classList.add(\"in-check\");",
        "      if (hintTargets.has(name)) {",
        "        sq.classList.add(hintTargets.get(name) ? \"hint-capture\" : \"hint\");",
        "      }",
        "      const sym = symbols[name];",
        "      if (sym) {",
        "        const span = document.createElement(\"span\");",
        "        span.className = \"piece \" + (sym === sym.toUpperCase() ? \"white\" : \"black\");",
        "        span.textContent = GLYPHS[sym];",
        "        sq.appendChild(span);",
        "      }",
        "      boardEl.appendChild(sq);",
        "    }",
        "  }",
        "  sizeBoard();",
        "  animateLastMove();",
        "}",
        "",
        "function animateLastMove() {",
        "  if (state.reviewPly !== null) return;",
        "  if (!state.lastMove || state.lastMove.uci === state.prevLastMoveUci) return;",
        "  state.prevLastMoveUci = state.lastMove.uci;",
        "  const { from, to } = state.lastMove;",
        "  const fromEl = boardEl.querySelector(`[data-square=\"${from}\"]`);",
        "  const toEl = boardEl.querySelector(`[data-square=\"${to}\"]`);",
        "  const pieceEl = toEl && toEl.querySelector(\".piece\");",
        "  if (!fromEl || !toEl || !pieceEl) return;",
        "  const dx = fromEl.offsetLeft - toEl.offsetLeft;",
        "  const dy = fromEl.offsetTop - toEl.offsetTop;",
        "  pieceEl.animate(",
        "    [{ transform: `translate(${dx}px, ${dy}px)` }, { transform: \"translate(0, 0)\" }],",
        "    { duration: 150, easing: \"ease-out\" }",
        "  );",
        "}",
        "",
        "// --- Players, captured pieces, clocks ---------------------------------",
        "",
        "function computerColor() {",
        "  if (!state.vs) return null;",
        "  return state.colorChoice === \"random\" ? state.actualColor : state.colorChoice;",
        "}",
        "",
        "function playerLabel(color) {",
        "  const cc = computerColor();",
        "  if (cc === \"w\") return color === \"w\" ? \"Ordinateur\" : \"Vous\";",
        "  if (cc === \"b\") return color === \"b\" ? \"Ordinateur\" : \"Vous\";",
        "  return color === \"w\" ? \"Blancs\" : \"Noirs\";",
        "}",
        "",
        "function computeCaptured(symbols) {",
        "  const counts = { w: { p: 0, n: 0, b: 0, r: 0, q: 0, k: 0 }, b: { p: 0, n: 0, b: 0, r: 0, q: 0, k: 0 } };",
        "  for (const sym of Object.values(symbols)) {",
        "    const c = sym === sym.toUpperCase() ? \"w\" : \"b\";",
        "    counts[c][sym.toLowerCase()]++;",
        "  }",
        "  const byType = (color, missingOf) => {",
        "    const list = [];",
        "    for (const t of [\"q\", \"r\", \"b\", \"n\", \"p\"]) {",
        "      for (let i = counts[missingOf][t]; i < START_COUNTS[t]; i++) list.push(t);",
        "    }",
        "    return list.sort((a, b) => VALUES[b] - VALUES[a]);",
        "  };",
        "  const capByW = byType(\"w\", \"b\"); // black pieces missing = captured by White",
        "  const capByB = byType(\"b\", \"w\");",
        "  const mat = (c) => Object.entries(counts[c]).reduce((s, [t, n]) => s + VALUES[t] * n, 0);",
        "  return { capByW, capByB, diff: mat(\"w\") - mat(\"b\") };",
        "}",
        "",
        "function renderPlayers() {",
        "  const topColor = state.flipped ? \"w\" : \"b\";",
        "  const bottomColor = state.flipped ? \"b\" : \"w\";",
        "  for (const [cardId, capId, color] of [",
        "    [\"player-top\", \"captured-top\", topColor],",
        "    [\"player-bottom\", \"captured-bottom\", bottomColor],",
        "  ]) {",
        "    const card = document.getElementById(cardId);",
        "    card.classList.toggle(\"active\", state.turn === color && state.reviewPly === null);",
        "    card.querySelector(\".pname\").textContent = playerLabel(color);",
        "    const { capByW, capByB, diff } = computeCaptured(state.symbols);",
        "    const mine = color === \"w\" ? capByW : capByB;",
        "    const opp = color === \"w\" ? \"b\" : \"w\";",
        "    const leading = (color === \"w\" && diff > 0) || (color === \"b\" && diff < 0);",
        "    const adv = leading ? ` <span class=\"adv\">+${Math.abs(diff)}</span>` : \"\";",
        "    const glyphs = mine",
        "      .map((t) => GLYPHS[opp === \"w\" ? t.toUpperCase() : t])",
        "      .join(\"\");",
        "    document.getElementById(capId).innerHTML = glyphs + adv;",
        "  }",
        "}",
        "",
        "function fmtClock(sec) {",
        "  const s = Math.max(0, Math.ceil(sec));",
        "  return Math.floor(s / 60) + \":\" + String(s % 60).padStart(2, \"0\");",
        "}",
        "",
        "function renderClocks() {",
        "  const mode = state.clockMode;",
        "  for (const [elId, color] of [[\"clock-top\", state.flipped ? \"w\" : \"b\"], [\"clock-bottom\", state.flipped ? \"b\" : \"w\"]]) {",
        "    const el = document.getElementById(elId);",
        "    if (mode === \"none\") {",
        "      el.textContent = \"\";",
        "      el.classList.remove(\"low\");",
        "    } else {",
        "      el.textContent = fmtClock(state.clock[color]);",
        "      el.classList.toggle(\"low\", state.clock[color] <= 30);",
        "    }",
        "  }",
        "}",
        "",
        "function clockBase() {",
        "  const m = state.clockMode;",
        "  if (m === \"none\") return null;",
        "  if (m === \"182\") return { base: 180, inc: 2 };",
        "  return { base: parseInt(m, 10), inc: 0 };",
        "}",
        "",
        "function resetClock() {",
        "  const c = clockBase();",
        "  state.clock = c",
        "    ? { w: c.base, b: c.base, inc: c.inc, active: state.turn, lastTs: null }",
        "    : { w: 0, b: 0, inc: 0, active: null, lastTs: null };",
        "}",
        "",
        "function tickClock() {",
        "  if (state.clockMode === \"none\" || state.reviewPly !== null) return;",
        "  const now = performance.now();",
        "  const c = state.clock;",
        "  if (c.active) {",
        "    if (c.lastTs != null) {",
        "      c[c.active] = Math.max(0, c[c.active] - (now - c.lastTs) / 1000);",
        "      if (c[c.active] <= 0) {",
        "        c.active = null;",
        "        showGameOver(\"Temps écoulé\", `${c.active === \"w\" ? \"Blancs\" : \"Noirs\"}…`);",
        "        const loser = c.lastTs != null ? state.turn : state.turn;",
        "        showGameOver(",
        "          \"Temps écoulé\",",
        "          `${loser === \"w\" ? \"Les Blancs\" : \"Les Noirs\"} perdent au temps — ${loser === \"w\" ? \"les Noirs\" : \"les Blancs\"} gagnent.`",
        "        );",
        "      }",
        "    }",
        "    c.lastTs = now;",
        "  }",
        "  renderClocks();",
        "}",
        "setInterval(tickClock, 200);",
        "",
        "// --- History + review mode ----------------------------------------------",
        "",
        "function renderHistory() {",
        "  historyEl.innerHTML = \"\";",
        "  const entries = state.history;",
        "  if (entries.length <= 1) {",
        "    historyEl.innerHTML = '<li class=\"empty\">aucun coup</li>';",
        "    return;",
        "  }",
        "  const lastPly = entries.length - 1;",
        "  for (let i = 1; i < entries.length; i += 2) {",
        "    const num = document.createElement(\"li\");",
        "    num.className = \"num\";",
        "    num.textContent = i / 2 + 1 + \".\";",
        "    historyEl.appendChild(num);",
        "    historyEl.appendChild(moveLi(entries[i], lastPly));",
        "    historyEl.appendChild(i + 1 < entries.length ? moveLi(entries[i + 1], lastPly) : document.createElement(\"li\"));",
        "  }",
        "  historyEl.scrollTop = historyEl.scrollHeight;",
        "}",
        "",
        "function moveLi(entry, lastPly) {",
        "  const li = document.createElement(\"li\");",
        "  li.className = \"move\";",
        "  li.textContent = entry.san;",
        "  if (state.reviewPly === entry.ply || (state.reviewPly === null && entry.ply === lastPly)) {",
        "    li.classList.add(\"current\");",
        "  }",
        "  li.title = entry.uci;",
        "  li.addEventListener(\"click\", () => {",
        "    state.reviewPly = state.reviewPly === entry.ply ? null : entry.ply;",
        "    state.selected = null;",
        "    renderAll();",
        "  });",
        "  return li;",
        "}",
        "",
        "function renderReviewBar() {",
        "  if (state.reviewPly === null) {",
        "    reviewBar.classList.add(\"hidden\");",
        "    return;",
        "  }",
        "  reviewBar.classList.remove(\"hidden\");",
        "  const lastPly = state.history.length - 1;",
        "  reviewLabel.textContent = `coup ${state.reviewPly}/${lastPly}`;",
        "}",
        "",
        "// --- Status / game over ---------------------------------------------------",
        "",
        "function setStatus(text) {",
        "  statusEl.textContent = text;",
        "}",
        "",
        "const RESULT_REASONS = {",
        "  checkmate: (s) => (s.turn === \"b\" ? \"Échec et mat — les Blancs gagnent.\" : \"Échec et mat — les Noirs gagnent.\"),",
        "  stalemate: () => \"Pat — partie nulle.\",",
        "  draw_fifty_move: () => \"Nulle — règle des 50 coups.\",",
        "  draw_repetition: () => \"Nulle — triple répétition.\",",
        "  draw_insufficient_material: () => \"Nulle — matériel insuffisant.\",",
        "};",
        "",
        "function showGameOver(title, reason) {",
        "  document.getElementById(\"gameover-title\").textContent = title;",
        "  document.getElementById(\"gameover-reason\").textContent = reason;",
        "  document.getElementById(\"gameover-modal\").classList.remove(\"hidden\");",
        "}",
        "",
        "function maybeShowGameOver(status) {",
        "  if (status.result === \"ongoing\") return;",
        "  if (state.gameOverShownFor === status.fen) return;",
        "  state.gameOverShownFor = status.fen;",
        "  const reason = (RESULT_REASONS[status.result] || (() => status.result))(status);",
        "  const title = status.result === \"checkmate\" ? \"Échec et mat !\" : \"Partie nulle\";",
        "  showGameOver(title, reason);",
        "}",
        "",
        "// --- Refresh --------------------------------------------------------------",
        "",
        "async function refresh() {",
        "  try {",
        "    const [board, status, moves, hist] = await Promise.all([",
        "      ChessAPI.board(),",
        "      ChessAPI.status(),",
        "      ChessAPI.moves(),",
        "      ChessAPI.history(),",
        "    ]);",
        "    const prevTurn = state.turn;",
        "    state.boardData = board;",
        "    state.turn = status.turn;",
        "    state.inCheck = status.in_check;",
        "    state.history = hist.entries;",
        "    state.lastMove = status.last_move",
        "      ? { from: status.last_move.slice(0, 2), to: status.last_move.slice(2, 4), uci: status.last_move }",
        "      : null;",
        "    if (prevTurn && prevTurn !== status.turn && state.clockMode !== \"none\") {",
        "      state.clock[prevTurn] += state.clock.inc; // increment for the mover",
        "    }",
        "    state.clock.active = status.turn;",
        "    state.legalMoves = moves.moves;",
        "    renderAll();",
        "    renderHistory();",
        "    renderClocks();",
        "    if (state.reviewPly === null) {",
        "      const turn = status.turn === \"w\" ? \"Blancs\" : \"Noirs\";",
        "      setStatus(",
        "        `${turn} jouent — ${status.result}${status.in_check ? \" — échec !\" : \"\"} — ${status.legal_move_count} coups légaux`",
        "      );",
        "    }",
        "    maybeShowGameOver(status);",
        "    maybeAiMove(status);",
        "  } catch (err) {",
        "    setStatus(\"Erreur: \" + err.message);",
        "  }",
        "}",
        "",
        "function renderAll() {",
        "  if (state.reviewPly !== null) {",
        "    const entry = state.history[state.reviewPly];",
        "    const parsed = parseFen(entry.fen);",
        "    state.symbols = parsed.symbols;",
        "    state.selected = null;",
        "    render();",
        "    setStatus(`Mode lecture — position après ${state.reviewPly} coup${state.reviewPly > 1 ? \"s\" : \"\"}`);",
        "  } else {",
        "    state.symbols = state.boardData ? state.boardData.squares : {};",
        "    render();",
        "  }",
        "  renderPlayers();",
        "  renderReviewBar();",
        "}",
        "",
        "async function maybeAiMove(status) {",
        "  const cc = computerColor();",
        "  if (!cc || state.thinking || status.result !== \"ongoing\" || status.turn !== cc) return;",
        "  if (state.reviewPly !== null) return;",
        "  state.thinking = true;",
        "  thinkingEl.classList.remove(\"hidden\");",
        "  try {",
        "    await ChessAPI.aiMove(state.depth);",
        "  } catch (err) {",
        "    setStatus(\"IA: \" + err.message);",
        "  }",
        "  state.thinking = false;",
        "  thinkingEl.classList.add(\"hidden\");",
        "  await refresh();",
        "}",
        "",
        "// --- Promotion ------------------------------------------------------------",
        "",
        "function askPromotion(color) {",
        "  return new Promise((resolve) => {",
        "    const modal = document.getElementById(\"promotion-modal\");",
        "    const box = document.getElementById(\"promo-choices\");",
        "    box.innerHTML = \"\";",
        "    const glyphs = color === \"w\" ? [\"♕\", \"♖\", \"♗\", \"♘\"] : [\"♛\", \"♜\", \"♝\", \"♞\"];",
        "    const letters = [\"q\", \"r\", \"b\", \"n\"];",
        "    glyphs.forEach((g, i) => {",
        "      const btn = document.createElement(\"button\");",
        "      btn.className = \"promo-btn\";",
        "      btn.textContent = g;",
        "      btn.addEventListener(\"click\", () => {",
        "        modal.classList.add(\"hidden\");",
        "        resolve(letters[i]);",
        "      });",
        "      box.appendChild(btn);",
        "    });",
        "    modal.classList.remove(\"hidden\");",
        "    modal.querySelector(\".modal-cancel\").onclick = () => {",
        "      modal.classList.add(\"hidden\");",
        "      resolve(null);",
        "    };",
        "  });",
        "}",
        "",
        "// --- Moves: click-click + drag & drop --------------------------------------",
        "",
        "async function tryMove(from, to) {",
        "  const candidates = state.legalMoves.filter((m) => m.startsWith(from + to));",
        "  if (candidates.length === 0) {",
        "    setStatus(`Coup illégal : ${from}${to}`);",
        "    return;",
        "  }",
        "  let uci = candidates[0];",
        "  if (candidates.length > 1) {",
        "    const sym = state.symbols[from] || \"\";",
        "    const color = sym === sym.toUpperCase() ? \"w\" : \"b\";",
        "    const promo = await askPromotion(color);",
        "    if (!promo) return;",
        "    uci = from + to + promo;",
        "  }",
        "  state.selected = null;",
        "  try {",
        "    await ChessAPI.move(uci);",
        "  } catch (err) {",
        "    setStatus(\"Coup illégal: \" + err.message);",
        "  }",
        "  state.reviewPly = null;",
        "  await refresh();",
        "}",
        "",
        "function squareFromEvent(e) {",
        "  const el = document.elementFromPoint(e.clientX, e.clientY);",
        "  const sq = el && el.closest ? el.closest(\".square\") : null;",
        "  return sq ? sq.dataset.square : null;",
        "}",
        "",
        "function myPieceAt(name) {",
        "  const sym = state.symbols[name];",
        "  if (!sym) return false;",
        "  return state.turn === \"w\" ? sym === sym.toUpperCase() : sym === sym.toLowerCase();",
        "}",
        "",
        "boardEl.addEventListener(\"pointerdown\", (e) => {",
        "  if (state.reviewPly !== null) return;",
        "  const name = squareFromEvent(e);",
        "  if (!name) return;",
        "  state.drag = { from: name, startX: e.clientX, startY: e.clientY, ghost: null, moved: false };",
        "});",
        "",
        "boardEl.addEventListener(\"pointermove\", (e) => {",
        "  const d = state.drag;",
        "  if (!d || state.reviewPly !== null) return;",
        "  if (!d.moved && Math.hypot(e.clientX - d.startX, e.clientY - d.startY) > 6 && myPieceAt(d.from)) {",
        "    d.moved = true;",
        "    const rect = boardEl.getBoundingClientRect();",
        "    const ghost = document.createElement(\"span\");",
        "    const sym = state.symbols[d.from] || \"\";",
        "    ghost.className = \"piece drag-ghost \" + (sym === sym.toUpperCase() ? \"white\" : \"black\");",
        "    ghost.textContent = GLYPHS[sym] || \"\";",
        "    ghost.style.left = e.clientX - rect.left + \"px\";",
        "    ghost.style.top = e.clientY - rect.top + \"px\";",
        "    boardEl.appendChild(ghost);",
        "    d.ghost = ghost;",
        "  }",
        "  if (d.ghost) {",
        "    const rect = boardEl.getBoundingClientRect();",
        "    d.ghost.style.left = e.clientX - rect.left + \"px\";",
        "    d.ghost.style.top = e.clientY - rect.top + \"px\";",
        "  }",
        "});",
        "",
        "boardEl.addEventListener(\"pointerup\", (e) => {",
        "  const d = state.drag;",
        "  state.drag = null;",
        "  if (!d || state.reviewPly !== null) return;",
        "  if (d.moved && d.ghost) {",
        "    d.ghost.remove();",
        "    const target = squareFromEvent(e);",
        "    if (target && target !== d.from) tryMove(d.from, target);",
        "    else renderAll();",
        "    return;",
        "  }",
        "  const name = squareFromEvent(e);",
        "  if (!name) return;",
        "  if (!state.selected) {",
        "    if (myPieceAt(name)) {",
        "      state.selected = name;",
        "      renderAll();",
        "    }",
        "  } else if (state.selected === name) {",
        "    state.selected = null;",
        "    renderAll();",
        "  } else {",
        "    tryMove(state.selected, name);",
        "  }",
        "});",
        "",
        "// --- Controls ---------------------------------------------------------------",
        "",
        "async function newGame() {",
        "  state.selected = null;",
        "  state.reviewPly = null;",
        "  state.gameOverShownFor = null;",
        "  document.getElementById(\"gameover-modal\").classList.add(\"hidden\");",
        "  if (state.vs && state.colorChoice === \"random\") {",
        "    state.actualColor = Math.random() < 0.5 ? \"w\" : \"b\";",
        "  }",
        "  await ChessAPI.newGame();",
        "  resetClock();",
        "  await refresh();",
        "}",
        "",
        "document.getElementById(\"btn-new\").addEventListener(\"click\", newGame);",
        "document.getElementById(\"btn-gameover-new\").addEventListener(\"click\", newGame);",
        "document.getElementById(\"btn-undo\").addEventListener(\"click\", async () => {",
        "  state.selected = null;",
        "  state.reviewPly = null;",
        "  try {",
        "    await ChessAPI.undo();",
        "  } catch (err) {",
        "    setStatus(\"Annuler: \" + err.message);",
        "  }",
        "  await refresh();",
        "});",
        "document.getElementById(\"btn-flip\").addEventListener(\"click\", () => {",
        "  state.flipped = !state.flipped;",
        "  lsSet(\"chess.flip\", state.flipped ? \"1\" : \"0\");",
        "  renderAll();",
        "});",
        "",
        "document.querySelectorAll(\"#review-bar [data-review]\").forEach((btn) => {",
        "  btn.addEventListener(\"click\", () => {",
        "    const lastPly = state.history.length - 1;",
        "    const cur = state.reviewPly === null ? lastPly : state.reviewPly;",
        "    const next = {",
        "      first: 0,",
        "      prev: Math.max(0, cur - 1),",
        "      next: Math.min(lastPly, cur + 1),",
        "      last: lastPly,",
        "    }[btn.dataset.review];",
        "    state.reviewPly = next;",
        "    state.selected = null;",
        "    renderAll();",
        "  });",
        "});",
        "document.getElementById(\"btn-exit-review\").addEventListener(\"click\", () => {",
        "  state.reviewPly = null;",
        "  state.selected = null;",
        "  renderAll();",
        "});",
        "",
        "// Options: vs computer, color, depth, clock",
        "const optVs = document.getElementById(\"opt-vs\");",
        "const optColor = document.getElementById(\"opt-color\");",
        "const optDepth = document.getElementById(\"opt-depth\");",
        "const optClock = document.getElementById(\"opt-clock\");",
        "optVs.checked = state.vs;",
        "optColor.value = state.colorChoice;",
        "optDepth.value = String(state.depth);",
        "optClock.value = state.clockMode;",
        "",
        "optVs.addEventListener(\"change\", async () => {",
        "  state.vs = optVs.checked;",
        "  lsSet(\"chess.vs\", state.vs ? \"1\" : \"0\");",
        "  const st = await ChessAPI.status();",
        "  maybeAiMove(st);",
        "});",
        "optColor.addEventListener(\"change\", () => {",
        "  state.colorChoice = optColor.value;",
        "  lsSet(\"chess.color\", state.colorChoice);",
        "});",
        "optDepth.addEventListener(\"change\", () => {",
        "  state.depth = parseInt(optDepth.value, 10);",
        "  lsSet(\"chess.depth\", optDepth.value);",
        "});",
        "optClock.addEventListener(\"change\", () => {",
        "  state.clockMode = optClock.value;",
        "  lsSet(\"chess.clock\", state.clockMode);",
        "  resetClock();",
        "  renderClocks();",
        "});",
        "",
        "// Import / export",
        "const ioText = document.getElementById(\"io-text\");",
        "document.getElementById(\"btn-load-fen\").addEventListener(\"click\", async () => {",
        "  const fen = ioText.value.trim();",
        "  if (!fen) return setStatus(\"Colle d'abord une FEN.\");",
        "  try {",
        "    await ChessAPI.load(fen);",
        "    state.reviewPly = null;",
        "    resetClock();",
        "    await refresh();",
        "  } catch (err) {",
        "    setStatus(\"FEN invalide: \" + err.message);",
        "  }",
        "});",
        "document.getElementById(\"btn-load-pgn\").addEventListener(\"click\", async () => {",
        "  const pgn = ioText.value.trim();",
        "  if (!pgn) return setStatus(\"Colle d'abord un PGN.\");",
        "  try {",
        "    await ChessAPI.loadPgn(pgn);",
        "    state.reviewPly = null;",
        "    resetClock();",
        "    await refresh();",
        "  } catch (err) {",
        "    setStatus(\"PGN invalide: \" + err.message);",
        "  }",
        "});",
        "async function copyText(text, what) {",
        "  try {",
        "    await navigator.clipboard.writeText(text);",
        "    setStatus(what + \" copié dans le presse-papiers.\");",
        "  } catch {",
        "    setStatus(what + \": \" + text);",
        "  }",
        "}",
        "document.getElementById(\"btn-copy-fen\").addEventListener(\"click\", async () => {",
        "  const r = await ChessAPI.fen();",
        "  await copyText(r.fen, \"FEN\");",
        "});",
        "document.getElementById(\"btn-copy-pgn\").addEventListener(\"click\", async () => {",
        "  const r = await ChessAPI.pgn();",
        "  await copyText(r.pgn, \"PGN\");",
        "});",
        "",
        "resetClock();",
        "refresh();",
        ""
      ]
    }
  }
}
