        "from itertools import combinations, permutations",
        "STD = ['R','N','B','Q','K','B','N','R']",
        "def try_all():",
        "    for dark_files, light_files in [([0,2,4,6],[1,3,5,7]), ([1,3,5,7],[0,2,4,6])]:",
