        "                    opts=[f for f in light_files if f in remaining]",
        "                    for f in opts:",
        "                        place[f]='B'; rec(stage+1, place, [x for x in remaining if x!=f]); del place[f]",
        "                elif ch=='Q':",
        "                    for f in remaining:",
        "                        place[f]='Q'; rec(stage+1, place, [x for x in remaining if x!=f]); del place[f]",
        "                else:",
        "                    for kn in combinations(sorted(remaining),2):",
        "                        place[kn[0]]='N'; place[kn[1]]='N'",
        "                        rec(stage+1, place, [x for x in remaining if x not in kn])",
        "                        del place[kn[0]]; del place[kn[1]]",
        "            rec(0, {}, list(range(8)))",
        "            if len(ranks)!=960: continue",
        "            for i,r in enumerate(ranks):",
        "                if r==STD:",
        "                    print(dark_files, order, i)",
        "try_all()",
