      "stdout": [
        "\"\"\"Exact mate-in-n puzzle scan with weak defender pieces (better hit rate for n=2/3).\"\"\"",
        "import json, os, random, sys, time",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.evaluation import MATE_SCORE",
        "from chess.ai.mate import can_mate_in, find_mates",
        "from chess.ai.search import _INF, negamax",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "",
        "rng = random.Random(777)",
        "THEME = {\"Q\": \"Mat à la dame\", \"R\": \"Mat à la tour\", \"N\": \"Mat du cavalier\",",
        "         \"B\": \"Mat du fou\", \"P\": \"Mat du pion\", \"K\": \"Mat aidé\"}",
        "EDGE = [s for s in range(64) if s % 8 in (0, 7) or s // 8 in (0, 7)]",
        "OUT = \"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\"",
        "",
        "def make(strong, extras, weak):",
        "    sqs = [None] * 64",
        "    kb = rng.choice(EDGE)",
        "    ks = rng.choice([s for s in range(64) if 1 < max(abs(s % 8 - kb % 8), abs(s // 8 - kb // 8)) <= 2])",
        "    sqs[kb] = \"k\" if strong == \"w\" else \"K\"",
        "    sqs[ks] = \"K\" if strong == \"w\" else \"k\"",
        "    for letter in extras:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is None:",
        "            sqs[s] = letter if strong == \"w\" else letter.lower()",
        "        else:",
        "            return None",
        "    for letter in weak:",
        "        s = rng.randrange(64)",
        "        if sqs[s] is None:",
        "            sqs[s] = letter.lower() if strong == \"w\" else letter.upper()",
        "        else:",
        "            return None",
        "    rows = []",
        "    for r in range(7, -1, -1):",
        "        row, e = \"\", 0",
        "        for f in range(8):",
        "            p = sqs[r * 8 + f]",
        "            if p is None:",
        "                e += 1",
        "            else:",
        "                if e:",
        "                    row += str(e); e = 0",
        "                row += p",
        "        if e:",
        "            row += str(e)",
        "        rows.append(row)",
        "    return \"/\".join(rows) + f\" {strong} - - 0 1\"",
        "",
        "def save(puzzles):",
        "    json.dump(puzzles, open(OUT, \"w\"), indent=2, ensure_ascii=False)",
        "",
        "all_found = []",
        "if os.path.exists(OUT):",
        "    all_found = json.load(open(OUT))",
        "    print(f\"resume with {len(all_found)}\", flush=True)",
        "",
        "def collect(n, wanted, strong_sets, weak_sets, max_tries):",
        "    have = sum(1 for q in all_found if q[\"level\"] == n)",
        "    found = []",
        "    tries = 0",
        "    t0 = time.time()",
        "    while have + len(found) < wanted and tries < max_tries:",
        "        tries += 1",
        "        strong = rng.choice([\"w\", \"b\"])",
        "        fen = make(strong, rng.choice(strong_sets), rng.choice(weak_sets))",
        "        if fen is None:",
        "            continue",
        "        try:",
        "            b = board_from_fen(fen)",
        "        except ValueError:",
        "            continue",
        "        if n == 2:",
        "            score, _ = negamax(b, 4, -_INF, _INF)",
        "            if score < MATE_SCORE or can_mate_in(b, 1):",
        "                continue",
        "            ms = find_mates(b, 2)",
        "        else:",
        "            score, _ = negamax(b, 6, -_INF, _INF)",
        "            if score < MATE_SCORE or can_mate_in(b, 2):",
        "                continue",
        "            ms = find_mates(b, 3)",
        "        if len(ms) == 1:",
        "            found.append({\"fen\": board_to_fen(b), \"solution\": ms[0].to_uci(), \"level\": n,",
        "                          \"theme\": THEME.get(b.piece_at(ms[0].from_sq).symbol.upper(), \"Mat forcé\")})",
        "            print(f\"n={n} #{len(found)} ({tries} tries, {time.time()-t0:.0f}s): {board_to_fen(b)} sol={ms[0].to_uci()}\", flush=True)",
        "            save(all_found + found)",
        "    return found",
        "",
        "r = collect(2, 12, [[\"Q\"], [\"R\", \"R\"], [\"Q\", \"R\"], [\"Q\", \"B\"], [\"R\", \"B\"], [\"Q\", \"N\"], [\"B\", \"B\"]],",
        "            [[\"p\"], [\"r\"], [\"n\"], [\"p\", \"p\"], [\"b\"], []], 6000)",
        "all_found += r",
        "r = collect(3, 8, [[\"Q\", \"R\"], [\"R\", \"R\"], [\"Q\", \"B\", \"B\"], [\"Q\", \"R\", \"R\"], [\"Q\"]],",
        "            [[\"p\"], [\"r\"], [\"p\", \"p\"], [\"n\"], []], 1500)",
        "all_found += r",
        "save(all_found)",
        "print(f\"TOTAL {len(all_found)}: l1={sum(1 for p in all_found if p['level']==1)} \"",
        "      f\"l2={sum(1 for p in all_found if p['level']==2)} l3={sum(1 for p in all_found if p['level']==3)}\")",
        ""
      ],
