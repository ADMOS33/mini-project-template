    "tool_input": {
      "timeout": 120,
      "command": [
        "cat > /Users/rafiq/.vibe/scratchpad/gen10.py <<'EOF'",
        "\"\"\"Exact mate-in-3: random Q+R (or Q) vs cornered black king, cheap filter chain.\"\"\"",
        "import json, os, random, sys, time, traceback",
        "sys.path.insert(0, \"/Users/rafiq/3A/projet-AI/mini-project-template\")",
        "from chess.ai.mate import find_mates, can_mate_in",
        "from chess.engine.fen import board_from_fen, board_to_fen",
        "from chess.engine.movegen import is_square_attacked",
        "from chess.engine.pieces import Color",
        "",
        "rng = random.Random(555)",
        "OUT = \"/Users/rafiq/.vibe/scratchpad/puzzles_raw.json\"",
        "DEADLINE = time.time() + 15 * 60",
        "CORNERS = [0, 7, 56, 63]",
        "",
        "def make(sqs, turn):",
        "    rows = []",
        "    for r in range(7, -1, -1):",
        "        row, e = \"\", 0",
        "        for f in range(8):",
        "            p = sqs[r * 8 + f]",
        "            if p is None: e += 1",
        "            else:",
        "                if e: row += str(e); e = 0",
        "                row += p",
        "        if e: row += str(e)",
        "        rows.append(row)",
        "    return board_from_fen(\"/\".join(rows) + f\" {turn} - - 0 1\")",
        "",
        "def save(puzzles):",
        "    json.dump(puzzles, open(OUT, \"w\"), indent=2, ensure_ascii=False)",
        "",
        "all_found = []",
        "if os.path.exists(OUT):",
        "    all_found = json.load(open(OUT))",
        "    print(f\"resume with {len(all_found)}\", flush=True)",
        "",
        "have = sum(1 for q in all_found if q[\"level\"] == 3)",
        "found = []",
        "t0 = time.time()",
        "tries = 0",
        "try:",
        "    while have + len(found) < 8 and time.time() < DEADLINE:",
        "        tries += 1",
        "        kb = rng.choice(CORNERS)",
        "        kf, kr = kb % 8, kb // 8",
        "        cands = [s for s in range(64) if max(abs(s % 8 - kf), abs(s // 8 - kr)) == 2]",
        "        ks = rng.choice(cands)",
        "        extras = rng.choice([[\"Q\", \"R\"], [\"Q\"], [\"R\", \"R\"], [\"Q\", \"B\"]])",
        "        sqs = [None] * 64",
        "        sqs[kb] = \"k\"; sqs[ks] = \"K\"",
        "        ok = True",
        "        for letter in extras:",
        "            s = rng.randrange(64)",
        "            if sqs[s] is not None: ok = False; break",
        "            sqs[s] = letter",
        "        if not ok: continue",
        "        try:",
        "            L = make(sqs, \"w\")",
        "        except ValueError:",
        "            continue",
        "        if is_square_attacked(L, L.king_square(Color.BLACK), Color.WHITE):",
        "            continue",
        "        if find_mates(L, 2):",
        "            continue",
        "        if not can_mate_in(L, 3):",
        "            continue",
        "        ms = find_mates(L, 3)",
        "        if len(ms) == 1:",
        "            found.append({\"fen\": board_to_fen(L), \"solution\": ms[0].to_uci(), \"level\": 3,",
        "                          \"theme\": \"Mat force\"})",
        "            print(f\"L3 #{len(found)} ({tries} tries, {time.time()-t0:.0f}s): \"",
        "                  f\"{board_to_fen(L)} sol={ms[0].to_uci()}\", flush=True)",
        "            save(all_found + found)",
        "except Exception:",
        "    traceback.print_exc()",
        "save(all_found + found)",
        "print(f\"DONE tries={tries} l3={have + len(found)}\", flush=True)",
        "EOF",
        "pkill -f gen9.py; echo ok"
      ]
    },
